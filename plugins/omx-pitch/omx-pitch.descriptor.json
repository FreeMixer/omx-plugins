{
  "$schema": "https://github.com/FreeMixer/omx-contract/raw/v3/schema/omx-contract.schema.json",
  "requires": {
    "omx-contract-schema": ">= 3.0.0"
  },
  "origin": "authored",
  "plugin": {
    "id": "org.openmixer.pitch",
    "format": "clap",
    "uri": "urn:openmixer:pitch",
    "name": "omx pitch",
    "vendor": "openmixer",
    "version": "0.15.1",
    "doc": "The console's pitch shifter: shifts both channels up or down by semitones and cents, without changing their length, mixed with the dry signal.",
    "features": [
      "audio-effect"
    ]
  },
  "controls": [
    {
      "id": 0,
      "symbol": "semitones",
      "name": "Semitones",
      "kind": "travel",
      "travel": {
        "min": -12,
        "max": 12,
        "step": 1,
        "unit": "st",
        "default": 0,
        "scale": "stepped"
      },
      "group": [
        "Pitch"
      ],
      "meaning": "shift",
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/pitch.json#PITCH_LIMITS.semitones",
          "at": "omx-dsp@0.26.0"
        }
      }
    },
    {
      "id": 1,
      "symbol": "cents",
      "name": "Cents",
      "kind": "travel",
      "travel": {
        "min": -50,
        "max": 50,
        "step": 1,
        "unit": "cents",
        "default": 0,
        "scale": "stepped"
      },
      "group": [
        "Pitch"
      ],
      "meaning": "fine",
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/pitch.json#PITCH_LIMITS.cents",
          "at": "omx-dsp@0.26.0"
        }
      }
    },
    {
      "id": 2,
      "symbol": "mix",
      "name": "Mix",
      "kind": "travel",
      "travel": {
        "min": 0,
        "max": 100,
        "step": 0,
        "unit": "%",
        "default": 100,
        "scale": "linear"
      },
      "group": [
        "Pitch"
      ],
      "meaning": "wetDryRatio",
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/pitch.json#PITCH_LIMITS.mix",
          "at": "omx-dsp@0.26.0"
        }
      }
    }
  ],
  "ports": [
    {
      "id": 0,
      "name": "in",
      "kind": "audio",
      "direction": "in",
      "role": "main",
      "channels": 2,
      "layout": "stereo"
    },
    {
      "id": 0,
      "name": "out",
      "kind": "audio",
      "direction": "out",
      "role": "main",
      "channels": 2,
      "layout": "stereo"
    }
  ],
  "needs": {
    "extensions": {
      "optional": [
        "lv2:hardRTCapable"
      ]
    }
  },
  "latency": {
    "reports": true
  },
  "extensions": {
    "clap": {
      "clap_plugin_descriptor.features": [
        "CLAP_PLUGIN_FEATURE_PITCH_SHIFTER",
        "CLAP_PLUGIN_FEATURE_STEREO"
      ]
    },
    "lv2": {
      "rdf:type": [
        "lv2:Plugin",
        "lv2:PitchPlugin"
      ]
    }
  },
  "source": {
    "impl": "plugins/omx-pitch/omx_pitch_clap.c#clap_entry"
  }
}
