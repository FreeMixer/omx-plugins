{
  "$schema": "https://github.com/FreeMixer/omx-contract/raw/v3/schema/omx-contract.schema.json",
  "requires": {
    "omx-contract-schema": ">= 3.7.0"
  },
  "origin": "authored",
  "plugin": {
    "id": "org.openmixer.balancer",
    "format": "clap",
    "uri": "urn:openmixer:balancer",
    "name": "omx balancer",
    "vendor": "openmixer",
    "version": "0.19.0",
    "doc": "Walks four bands slowly toward a target tone, so a mix settles toward a pink-noise balance without chasing notes.",
    "features": [
      "audio-effect"
    ]
  },
  "controls": [
    {
      "id": 0,
      "symbol": "amountPct",
      "name": "Amount",
      "kind": "travel",
      "travel": {
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "default": 0,
        "scale": "stepped"
      },
      "group": [
        "Balancer"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/balancer.json#BALANCER_AMOUNT_PCT_RANGE",
          "at": "omx-dsp@0.30.0"
        }
      }
    },
    {
      "id": 1,
      "symbol": "rangeDb",
      "name": "Range",
      "kind": "travel",
      "travel": {
        "min": 1,
        "max": 12,
        "step": 0,
        "unit": "dB",
        "default": 3,
        "scale": "linear"
      },
      "group": [
        "Balancer"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/balancer.json#BALANCER_RANGE_DB_RANGE",
          "at": "omx-dsp@0.30.0"
        }
      }
    },
    {
      "id": 2,
      "symbol": "speedDbPerS",
      "name": "Speed",
      "kind": "travel",
      "travel": {
        "min": 0.1,
        "max": 6,
        "step": 0,
        "unit": "dB",
        "default": 0.5,
        "scale": "linear"
      },
      "group": [
        "Balancer"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/balancer.json#BALANCER_SPEED_DB_PER_S_RANGE",
          "at": "omx-dsp@0.30.0"
        }
      }
    },
    {
      "id": 3,
      "symbol": "slopeDbOct",
      "name": "Slope",
      "kind": "travel",
      "travel": {
        "min": -6,
        "max": 0,
        "step": 0,
        "unit": "dB/oct",
        "default": -3,
        "scale": "linear"
      },
      "group": [
        "Balancer"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/balancer.json#BALANCER_SLOPE_DB_OCT_RANGE",
          "at": "omx-dsp@0.30.0"
        }
      }
    }
  ],
  "ports": [
    {
      "id": 0,
      "name": "in",
      "kind": "audio",
      "direction": "in",
      "role": "main",
      "channels": 2,
      "layout": "stereo"
    },
    {
      "id": 0,
      "name": "out",
      "kind": "audio",
      "direction": "out",
      "role": "main",
      "channels": 2,
      "layout": "stereo"
    }
  ],
  "needs": {
    "extensions": {
      "optional": [
        "lv2:hardRTCapable"
      ]
    }
  },
  "latency": {
    "reports": true
  },
  "extensions": {
    "clap": {
      "clap_plugin_descriptor.features": [
        "CLAP_PLUGIN_FEATURE_EQUALIZER",
        "CLAP_PLUGIN_FEATURE_STEREO"
      ]
    },
    "lv2": {
      "rdf:type": [
        "lv2:Plugin",
        "lv2:EQPlugin"
      ]
    }
  },
  "source": {
    "impl": "plugins/omx-balancer/omx_balancer_clap.c#clap_entry"
  }
}
