  "order": "permutable",
  "shipped": "v0.2.0",
  "shippedDiff": [
    "0 trimDb -> trimOn",
    "1 hpfOn -> trimDb",
    "2 hpfFreq -> filterOn",
    "3 hpfSlope -> hpfOn",
    "4 lpfOn -> hpfFreq",
    "5 lpfFreq -> hpfSlope",
    "6 lpfSlope -> lpfOn",
    "7 gateOn -> lpfFreq",
    "8 gateThreshold -> lpfSlope",
    "9 gateRatio -> gateOn",
    "10 gateRange -> gateThreshold",
    "11 gateAttack -> gateRatio",
    "12 gateRelease -> gateRange",
    "13 eqOn -> gateAttack",
    "14 eq1Type -> gateRelease",
    "15 eq1Freq -> gateKneeStart",
    "16 eq1Gain -> gateKneeEnd",
    "17 eq1Q -> gateHold",
    "18 eq1On -> gateHysteresis",
    "19 eq2Type -> eqOn",
    "20 eq2Freq -> eq1Type",
    "21 eq2Gain -> eq1Freq",
    "22 eq2Q -> eq1Gain",
    "23 eq2On -> eq1Q",
    "24 eq3Type -> eq1On",
    "25 eq3Freq -> eq2Type",
    "26 eq3Gain -> eq2Freq",
    "27 eq3Q -> eq2Gain",
    "28 eq3On -> eq2Q",
    "29 eq4Type -> eq2On",
    "30 eq4Freq -> eq3Type",
    "31 eq4Gain -> eq3Freq",
    "32 eq4Q -> eq3Gain",
    "33 eq4On -> eq3Q",
    "34 compOn -> eq3On",
    "35 compThreshold -> eq4Type",
    "36 compRatio -> eq4Freq",
    "37 compKnee -> eq4Gain",
    "38 compAttack -> eq4Q",
    "39 compRelease -> eq4On",
    "40 compMakeup -> eq5Type",
    "41 compRms -> eq5Freq",
    "42 order -> eq5Gain",
    "+43 eq5Q",
    "+44 eq5On",
    "+45 eq6Type",
    "+46 eq6Freq",
    "+47 eq6Gain",
    "+48 eq6Q",
    "+49 eq6On",
    "+50 eq7Type",
    "+51 eq7Freq",
    "+52 eq7Gain",
    "+53 eq7Q",
    "+54 eq7On",
    "+55 eq8Type",
    "+56 eq8Freq",
    "+57 eq8Gain",
    "+58 eq8Q",
    "+59 eq8On",
    "+60 compOn",
    "+61 compThreshold",
    "+62 compRatio",
    "+63 compKnee",
    "+64 compAttack",
    "+65 compRelease",
    "+66 compMakeup",
    "+67 compKind",
    "+68 compMix",
    "+69 compDetectorOversampling",
    "+70 order"
  ],
  "manual": [
    "Five stages, each omx-dsp's instance face of the console's own kernel, run one after the other; each has its own switch:",
    "",
    "| Stage | Parameters |",
    "|---|---|",
    "| Input | on/off; Trim, a click-free ramp to each new gain |",
    "| Filters | on/off; HPF and LPF, each on/off, its frequency, 12 or 24 dB/oct |",
    "| Gate | on/off, threshold, ratio, range, attack, release, knee start and end, hold, hysteresis |",
    "| EQ | on/off; eight bands, each on/off, type (bell, low or high shelf, notch, all-pass 1st or 2nd order), frequency, gain, Q |",
    "| Comp | on/off, threshold, ratio, knee, attack, release, make-up, kind (compressor: RMS detector; limiter: peak), mix, detector oversampling (auto, off, 4x) |",
    "",
    "**Order** (0 to 119) picks the order of the five stages: 0 is the desk's input > filters > gate > EQ >",
    "comp, and the rest follow in lexicographic order (1 is input > filters > gate > comp > EQ, ... 119 is",
    "comp > EQ > gate > filters > input). Plus the host's bypass. The latency reported is the sum of the",
    "stages': the gate's and the compressor's 4x detector paths while they are engaged, else zero."
  ]
}
