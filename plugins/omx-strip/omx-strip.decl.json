          "ref": "EQ_Q_RANGE",
          "defaultRef": "EQ_BAND_DEFAULTS.q"
        },
        {
          "symbol": "eq2On",
          "name": "EQ 2",
          "ref": "EQ_BAND_ONS"
        },
        {
          "symbol": "eq3Type",
          "name": "EQ 3 Type",
          "ref": "EQ_BAND_TYPES",
          "defaultBand": {
            "strip": "eq8",
            "index": 2,
            "of": "type"
          }
        },
        {
          "symbol": "eq3Freq",
          "name": "EQ 3 Freq",
          "ref": "EQ_FREQ_RANGE",
          "defaultBand": {
            "strip": "eq8",
            "index": 2,
            "of": "centre"
          }
        },
        {
          "symbol": "eq3Gain",
          "name": "EQ 3 Gain",
          "ref": "EQ_GAIN_RANGE",
