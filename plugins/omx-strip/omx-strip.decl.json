          "name": "HPF Freq",
          "ref": "HPF_FREQ_RANGE",
          "defaultRef": "EQ_PASS_FILTER_DEFAULTS.hpfFreqHz"
        },
        {
          "symbol": "hpfSlope",
          "name": "HPF Slope",
          "ref": "FILTER_SLOPES",
          "unit": "dB/oct"
        },
        {
          "symbol": "lpfOn",
          "name": "LPF",
          "ref": "EQ_LPF_ONS"
        },
        {
          "symbol": "lpfFreq",
          "name": "LPF Freq",
          "ref": "LPF_FREQ_RANGE",
          "defaultRef": "EQ_PASS_FILTER_DEFAULTS.lpfFreqHz"
        },
        {
          "symbol": "lpfSlope",
          "name": "LPF Slope",
          "ref": "FILTER_SLOPES",
          "unit": "dB/oct"
        }
      ],
      "faceBands": "eq8",
      "fixed": {
        "bandType": "default",
        "freq": "default",
        "gain": "default",
        "q": "default",
        "bandOn": "off"
