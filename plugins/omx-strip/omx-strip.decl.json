          "defaultRef": "EQ_BAND_DEFAULTS.gainDb"
        },
        {
          "symbol": "eq4Q",
          "name": "EQ 4 Q",
          "ref": "EQ_Q_RANGE",
          "defaultRef": "EQ_BAND_DEFAULTS.q"
        },
        {
          "symbol": "eq4On",
          "name": "EQ 4",
          "ref": "EQ_BAND_ONS"
        },
        {
          "symbol": "eq5Type",
          "name": "EQ 5 Type",
          "ref": "EQ_BAND_TYPES",
          "defaultBand": {
            "strip": "eq8",
            "index": 4,
            "of": "type"
          }
        },
        {
          "symbol": "eq5Freq",
          "name": "EQ 5 Freq",
          "ref": "EQ_FREQ_RANGE",
          "defaultBand": {
            "strip": "eq8",
            "index": 4,
