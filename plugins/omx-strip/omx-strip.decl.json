      "kernel": "gate",
      "name": "Gate",
      "on": false,
      "params": [
        {
          "symbol": "gateThreshold",
          "name": "Gate Threshold",
          "ref": "GATE_CONTINUOUS_TRAVELS",
          "field": "thresholdDb"
        },
        {
          "symbol": "gateRatio",
          "name": "Gate Ratio",
          "ref": "GATE_CONTINUOUS_TRAVELS",
          "field": "ratio"
        },
        {
          "symbol": "gateRange",
          "name": "Gate Range",
          "ref": "GATE_CONTINUOUS_TRAVELS",
          "field": "rangeDb"
        },
        {
          "symbol": "gateAttack",
          "name": "Gate Attack",
          "ref": "GATE_LIMITS",
          "field": "attackMs"
        },
        {
          "symbol": "gateRelease",
          "name": "Gate Release",
          "ref": "GATE_CONTINUOUS_TRAVELS",
          "field": "releaseMs"
        },
        {
          "symbol": "gateKneeStart",
          "name": "Gate Knee Start",
          "ref": "GATE_LIMITS",
          "field": "kneeStartDb"
        },
        {
          "symbol": "gateKneeEnd",
          "name": "Gate Knee End",
          "ref": "GATE_LIMITS",
          "field": "kneeEndDb"
        },
        {
          "symbol": "gateHold",
          "name": "Gate Hold",
          "ref": "GATE_LIMITS",
          "field": "holdMs"
        },
        {
          "symbol": "gateHysteresis",
          "name": "Gate Hysteresis",
          "ref": "GATE_LIMITS",
          "field": "hysteresisDb"
        }
