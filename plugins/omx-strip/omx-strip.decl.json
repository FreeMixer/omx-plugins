      "id": "eq",
      "kernel": "eq",
      "name": "EQ",
      "on": true,
      "params": [
        {
          "symbol": "eq1Type",
          "name": "EQ 1 Type",
          "ref": "EQ_BAND_TYPES",
          "defaultBand": {
            "strip": "strip",
            "index": 0,
