{
  "$comment": "THE declaration of omx-strip, the folder's one hand-written file. Every other file of the folder is generated from it by tools/gen.mjs. A chain of omx-dsp instance faces (trim, eq, gate, eq, comp): each element's parameters are by reference to omx-contract's kernel of that element and bind by name to its face. The parameter list is generated from the chain and is append-only.",
  "stem": "omx-strip",
  "kernel": "strip",
  "name": "omx strip",
  "noun": "channel strip",
  "vendor": "openmixer",
  "url": "https://github.com/FreeMixer/omx-plugins",
  "version": "0.2.0",
  "description": "The OpenMixer console's channel strip in one plugin: input trim, high- and low-pass filters, gate, eight-band EQ and compressor, in the console's order or any other. No DSP of its own: each stage is omx-dsp's instance face of the console's kernel, called in order.",
  "summary": "The console's channel strip in one plugin: input trim, HPF/LPF, gate, eight-band EQ and compressor, in the desk's order or any other. Stereo, real-time safe, 44.1 to 192 kHz.",
  "clap": {
    "id": "org.openmixer.strip",
    "features": [
      "audio-effect",
      "mixing",
      "stereo"
    ]
  },
  "lv2": {
    "uri": "urn:openmixer:strip",
    "class": "lv2:MixerPlugin"
  },
  "binding": "chain",
  "chain": [
    {
      "id": "trim",
      "kernel": "trim",
      "name": "Input",
      "on": true,
      "params": [
        {
          "symbol": "trimDb",
          "name": "Trim",
          "ref": "TRIM_RANGE"
        }
      ]
    },
    {
      "id": "filter",
      "kernel": "eq",
      "name": "Filters",
      "on": true,
      "params": [
        {
          "symbol": "hpfOn",
          "name": "HPF",
          "ref": "EQ_HPF_ONS"
        },
        {
          "symbol": "hpfFreq",
          "name": "HPF Freq",
          "ref": "HPF_FREQ_RANGE",
          "defaultRef": "EQ_PASS_FILTER_DEFAULTS.hpfFreqHz"
        },
        {
          "symbol": "hpfSlope",
          "name": "HPF Slope",
          "ref": "FILTER_SLOPES",
          "unit": "dB/oct"
        },
        {
          "symbol": "lpfOn",
          "name": "LPF",
          "ref": "EQ_LPF_ONS"
        },
        {
          "symbol": "lpfFreq",
          "name": "LPF Freq",
          "ref": "LPF_FREQ_RANGE",
          "defaultRef": "EQ_PASS_FILTER_DEFAULTS.lpfFreqHz"
        },
        {
          "symbol": "lpfSlope",
          "name": "LPF Slope",
          "ref": "FILTER_SLOPES",
          "unit": "dB/oct"
        }
      ],
      "bands": "eq8",
      "fixed": {
        "bandType": "default",
        "freq": "default",
        "gain": "default",
        "q": "default",
        "bandOn": "off"
      }
    },
    {
      "id": "gate",
      "kernel": "gate",
      "name": "Gate",
      "on": false,
      "params": [
        {
          "symbol": "gateThreshold",
          "name": "Gate Threshold",
          "ref": "GATE_CONTINUOUS_TRAVELS",
          "field": "thresholdDb"
        },
        {
          "symbol": "gateRatio",
          "name": "Gate Ratio",
          "ref": "GATE_CONTINUOUS_TRAVELS",
          "field": "ratio"
        },
        {
          "symbol": "gateRange",
          "name": "Gate Range",
          "ref": "GATE_CONTINUOUS_TRAVELS",
          "field": "rangeDb"
        },
        {
          "symbol": "gateAttack",
          "name": "Gate Attack",
          "ref": "GATE_LIMITS",
          "field": "attackMs"
        },
        {
          "symbol": "gateRelease",
          "name": "Gate Release",
          "ref": "GATE_CONTINUOUS_TRAVELS",
          "field": "releaseMs"
        },
        {
          "symbol": "gateKneeStart",
          "name": "Gate Knee Start",
          "ref": "GATE_LIMITS",
          "field": "kneeStartDb"
        },
        {
          "symbol": "gateKneeEnd",
          "name": "Gate Knee End",
          "ref": "GATE_LIMITS",
          "field": "kneeEndDb"
        },
        {
          "symbol": "gateHold",
          "name": "Gate Hold",
          "ref": "GATE_LIMITS",
          "field": "holdMs"
        },
        {
          "symbol": "gateHysteresis",
          "name": "Gate Hysteresis",
          "ref": "GATE_LIMITS",
          "field": "hysteresisDb"
        }
      ],
      "fixed": {
        "keySource": "self"
      }
    },
    {
      "id": "eq",
      "kernel": "eq",
      "name": "EQ",
      "on": true,
      "params": [
        {
          "symbol": "eq1Type",
          "name": "EQ 1 Type",
          "ref": "EQ_BAND_TYPES",
          "defaultBand": {
            "strip": "eq8",
            "index": 0,
            "of": "type"
          }
        },
        {
          "symbol": "eq1Freq",
          "name": "EQ 1 Freq",
          "ref": "EQ_FREQ_RANGE",
          "defaultBand": {
            "strip": "eq8",
            "index": 0,
            "of": "centre"
          }
        },
        {
          "symbol": "eq1Gain",
          "name": "EQ 1 Gain",
          "ref": "EQ_GAIN_RANGE",
          "defaultRef": "EQ_BAND_DEFAULTS.gainDb"
        },
        {
          "symbol": "eq1Q",
          "name": "EQ 1 Q",
          "ref": "EQ_Q_RANGE",
          "defaultRef": "EQ_BAND_DEFAULTS.q"
        },
        {
          "symbol": "eq1On",
          "name": "EQ 1",
          "ref": "EQ_BAND_ONS"
        },
        {
          "symbol": "eq2Type",
          "name": "EQ 2 Type",
          "ref": "EQ_BAND_TYPES",
          "defaultBand": {
            "strip": "eq8",
            "index": 1,
            "of": "type"
          }
        },
        {
          "symbol": "eq2Freq",
          "name": "EQ 2 Freq",
          "ref": "EQ_FREQ_RANGE",
          "defaultBand": {
            "strip": "eq8",
            "index": 1,
