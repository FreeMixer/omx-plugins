# lv2:displayPriority on a port group is the term Zynthian reads to order a plugin's groups (zynthian_lv2.py), and the
# one FreeMixer/omx-plugins#257 rules; LV2 defines none in lv2core (port-props' pprops:displayPriority is a port's), so
# it is stated here, for a validator, as what it is.
lv2:displayPriority
    a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> ;
    rdfs:label "display priority" ;
    rdfs:comment "A port group's rank among its plugin's groups, higher first, as Zynthian reads it." .

<urn:openmixer:strip#trim>
    a pg:Group ;
    lv2:symbol "trim" ;
    lv2:name "Input" ;
    lv2:displayPriority 6 ;
    rdfs:label "Input" .

<urn:openmixer:strip#filter>
    a pg:Group ;
    lv2:symbol "filter" ;
    lv2:name "Filters" ;
    lv2:displayPriority 5 ;
    rdfs:label "Filters" .

<urn:openmixer:strip#gate>
    a pg:Group ;
    lv2:symbol "gate" ;
    lv2:name "Gate" ;
    lv2:displayPriority 4 ;
    rdfs:label "Gate" .

<urn:openmixer:strip#eq>
    a pg:Group ;
    lv2:symbol "eq" ;
    lv2:name "EQ" ;
    lv2:displayPriority 3 ;
    rdfs:label "EQ" .

<urn:openmixer:strip#comp>
    a pg:Group ;
    lv2:symbol "comp" ;
    lv2:name "Comp" ;
    lv2:displayPriority 2 ;
    rdfs:label "Comp" .

<urn:openmixer:strip#order>
    a pg:Group ;
    lv2:symbol "order" ;
    lv2:name "Order" ;
    lv2:displayPriority 1 ;
    rdfs:label "Order" .

<urn:openmixer:unit#dBoct>
    a units:Unit ;
    rdfs:label "decibels per octave" ;
    units:render "%f dB/oct" ;
    units:symbol "dB/oct" .
