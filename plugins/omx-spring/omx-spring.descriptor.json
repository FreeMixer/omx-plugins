{
  "$schema": "https://github.com/FreeMixer/omx-contract/raw/v3/schema/omx-contract.schema.json",
  "requires": {
    "omx-contract-schema": ">= 3.1.0"
  },
  "origin": "authored",
  "plugin": {
    "id": "org.openmixer.spring",
    "format": "clap",
    "uri": "urn:openmixer:spring",
    "name": "omx spring",
    "vendor": "openmixer",
    "version": "0.16.1",
    "doc": "A spring reverb: a delay, a chain of all-passes and a darkening loop, with decay, length, tension and damping.",
    "features": [
      "audio-effect"
    ]
  },
  "controls": [
    {
      "id": 0,
      "symbol": "decayS",
      "name": "Decay",
      "kind": "travel",
      "travel": {
        "min": 0.5,
        "max": 8,
        "step": 0,
        "unit": "s",
        "default": 2,
        "scale": "linear"
      },
      "group": [
        "Spring"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/spring.json#SPRING_DECAY_S_RANGE",
          "at": "omx-dsp@0.28.0"
        }
      }
    },
    {
      "id": 1,
      "symbol": "lengthMs",
      "name": "Length",
      "kind": "travel",
      "travel": {
        "min": 20,
        "max": 60,
        "step": 1,
        "unit": "ms",
        "default": 35,
        "scale": "stepped"
      },
      "group": [
        "Spring"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/spring.json#SPRING_LENGTH_MS_RANGE",
          "at": "omx-dsp@0.28.0"
        }
      }
    },
    {
      "id": 2,
      "symbol": "tensionPct",
      "name": "Tension",
      "kind": "travel",
      "travel": {
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "default": 50,
        "scale": "stepped"
      },
      "group": [
        "Spring"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/spring.json#SPRING_TENSION_PCT_RANGE",
          "at": "omx-dsp@0.28.0"
        }
      }
    },
    {
      "id": 3,
      "symbol": "dampHz",
      "name": "Damping",
      "kind": "travel",
      "travel": {
        "min": 1000,
        "max": 10000,
        "step": 1,
        "unit": "Hz",
        "default": 4000,
        "scale": "log"
      },
      "group": [
        "Spring"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/spring.json#SPRING_DAMP_HZ_RANGE",
          "at": "omx-dsp@0.28.0"
        }
      }
    },
    {
      "id": 4,
      "symbol": "mixPct",
      "name": "Mix",
      "kind": "travel",
      "travel": {
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "default": 0,
        "scale": "stepped"
      },
      "group": [
        "Spring"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/spring.json#SPRING_MIX_PCT_RANGE",
          "at": "omx-dsp@0.28.0"
        }
      }
    }
  ],
  "ports": [
    {
      "id": 0,
      "name": "in",
      "kind": "audio",
      "direction": "in",
      "role": "main",
      "channels": 2,
      "layout": "stereo"
    },
    {
      "id": 0,
      "name": "out",
      "kind": "audio",
      "direction": "out",
      "role": "main",
      "channels": 2,
      "layout": "stereo"
    }
  ],
  "needs": {
    "extensions": {
      "optional": [
        "lv2:hardRTCapable"
      ]
    }
  },
  "latency": {
    "reports": true
  },
  "extensions": {
    "clap": {
      "clap_plugin_descriptor.features": [
        "CLAP_PLUGIN_FEATURE_REVERB",
        "CLAP_PLUGIN_FEATURE_STEREO"
      ]
    },
    "lv2": {
      "rdf:type": [
        "lv2:Plugin",
        "lv2:ReverbPlugin"
      ]
    }
  },
  "source": {
    "impl": "plugins/omx-spring/omx_spring_clap.c#clap_entry"
  }
}
