    },
    {
      "id": 6,
      "symbol": "kneeDb",
      "name": "Knee",
      "kind": "travel",
      "travel": {
        "min": 0,
        "max": 24,
        "step": 0,
        "unit": "dB",
        "default": 6,
        "scale": "linear"
      },
      "group": [
        "Duck"
      ],
      "meaning": "knee",
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/comp.json#COMP_LIMITS.kneeDb",
