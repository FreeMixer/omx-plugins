        }
      }
    },
    {
      "id": 8,
      "symbol": "keyLpHz",
      "name": "Key Low-Pass",
      "kind": "travel",
      "travel": {
        "min": 0,
        "max": 20000,
        "step": 1,
        "unit": "Hz",
        "default": 0,
        "scale": "stepped"
      },
      "group": [
        "Key"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/comp.json#COMP_KEY_LP_HZ_RANGE",
          "at": "omx-dsp@0.31.0"
        }
      }
    },
    {
      "id": 9,
      "symbol": "keyListen",
      "name": "Key Listen",
      "kind": "toggle",
      "default": false,
      "group": [
        "Key"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/comp.json#COMP_KEY_LISTENS",
          "at": "omx-dsp@0.31.0"
        }
      }
    }
  ],
  "ports": [
    {
      "id": 0,
      "name": "in",
      "kind": "audio",
      "direction": "in",
      "role": "main",
      "channels": 2,
      "layout": "stereo"
    },
    {
      "id": 1,
      "name": "key",
      "kind": "audio",
      "direction": "in",
      "role": "sidechain",
      "channels": 1,
      "layout": "mono"
    },
    {
      "id": 0,
      "name": "out",
      "kind": "audio",
      "direction": "out",
      "role": "main",
      "channels": 2,
      "layout": "stereo"
    }
  ],
  "needs": {
    "extensions": {
      "optional": [
        "lv2:hardRTCapable"
      ]
    }
  },
  "latency": {
    "reports": true
  },
  "extensions": {
    "clap": {
      "clap_plugin_descriptor.features": [
        "CLAP_PLUGIN_FEATURE_COMPRESSOR",
        "CLAP_PLUGIN_FEATURE_STEREO"
      ]
    },
    "lv2": {
      "rdf:type": [
        "lv2:Plugin",
        "lv2:CompressorPlugin"
      ]
    }
  },
  "source": {
    "impl": "plugins/omx-ducker/omx_ducker_clap.c#clap_entry"
  }
}
