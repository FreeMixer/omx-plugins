{
  "$schema": "https://github.com/FreeMixer/omx-contract/raw/v3/schema/omx-contract.schema.json",
  "requires": {
    "omx-contract-schema": ">= 3.7.0"
  },
  "origin": "authored",
  "plugin": {
    "id": "org.openmixer.ducker",
    "format": "clap",
    "uri": "urn:openmixer:ducker",
    "name": "omx ducker",
    "vendor": "openmixer",
    "version": "0.19.2",
    "doc": "Pulls the programme down while a key is heard, music under a voice, by a set depth with attack, hold and release, the console ducker.",
    "features": [
      "audio-effect"
    ]
  },
  "controls": [
    {
      "id": 0,
      "symbol": "thresholdDb",
      "name": "Threshold",
      "kind": "travel",
      "travel": {
        "min": -60,
        "max": 0,
        "step": 1,
        "unit": "dB",
        "default": -18,
        "scale": "stepped"
      },
      "group": [
        "Duck"
      ],
      "meaning": "threshold",
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/comp.json#COMP_LIMITS.thresholdDb",
          "at": "omx-dsp@0.31.0"
        }
      }
    },
    {
      "id": 1,
      "symbol": "rangeDb",
      "name": "Depth",
      "kind": "travel",
      "travel": {
        "min": -40,
        "max": 0,
        "step": 1,
        "unit": "dB",
        "default": -12,
        "scale": "stepped"
      },
      "group": [
        "Duck"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/comp.json#COMP_RANGE_DB_RANGE",
          "at": "omx-dsp@0.31.0"
        }
      }
    },
    {
      "id": 2,
      "symbol": "attackMs",
      "name": "Attack",
      "kind": "travel",
      "travel": {
        "min": 0.1,
        "max": 100,
        "step": 0,
        "unit": "ms",
        "default": 5,
        "scale": "linear"
      },
      "group": [
        "Timing"
      ],
      "meaning": "attack",
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/comp.json#COMP_LIMITS.attackMs",
          "at": "omx-dsp@0.31.0"
        }
      }
    },
    {
      "id": 3,
      "symbol": "holdMs",
      "name": "Hold",
      "kind": "travel",
      "travel": {
        "min": 0,
        "max": 2000,
        "step": 1,
        "unit": "ms",
        "default": 0,
        "scale": "stepped"
      },
      "group": [
        "Timing"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/comp.json#COMP_HOLD_MS_RANGE",
          "at": "omx-dsp@0.31.0"
        }
      }
    },
    {
      "id": 4,
      "symbol": "releaseMs",
      "name": "Release",
      "kind": "travel",
      "travel": {
        "min": 5,
        "max": 3000,
        "step": 1,
        "unit": "ms",
        "default": 200,
        "scale": "stepped"
      },
      "group": [
        "Timing"
      ],
      "meaning": "release",
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/comp.json#COMP_LIMITS.releaseMs",
          "at": "omx-dsp@0.31.0"
        }
      }
    },
    {
      "id": 5,
      "symbol": "ratio",
      "name": "Ratio",
      "kind": "travel",
      "travel": {
        "min": 1,
        "max": 20,
        "step": 0,
        "unit": "ratio",
        "default": 4,
        "scale": "linear"
