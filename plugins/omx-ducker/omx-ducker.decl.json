{
  "$comment": "The extras of omx-ducker's declaration: what its descriptor, omx-ducker.descriptor.json, has no word for (docs/declaration-as-descriptor.md). The two are the folder's hand-written files; tools/gen.mjs generates the rest and writes the travels the descriptor's links resolve to. Its parameters are by reference to omx-contract's ducker kernel and bind by name to omx-dsp's instance face. Control order, the descriptor's, is append-only.",
  "stem": "omx-ducker",
  "kernel": "ducker",
  "kernels": [
    "comp"
  ],
  "noun": "ducker",
  "url": "https://github.com/FreeMixer/omx-plugins",
  "binding": "instance",
  "sidechain": {
    "symbol": "key",
    "name": "Key (Sidechain)"
  },
  "portHints": {
    "enabled": {
      "props": [
        "lv2:toggled"
      ]
    },
    "latency": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:frame"
    },
    "key": {
      "props": [
        "lv2:connectionOptional",
        "lv2:isSideChain"
      ]
    },
    "thresholdDb": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:db"
    },
    "rangeDb": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:db"
    },
    "attackMs": {
      "unit": "units:ms"
    },
    "holdMs": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:ms"
    },
    "releaseMs": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:ms"
    },
    "kneeDb": {
      "unit": "units:db"
    },
    "keyHpHz": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:hz"
    },
    "keyLpHz": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:hz"
    },
    "keyListen": {
      "props": [
        "lv2:toggled"
      ]
    }
  },
  "fixed": {
    "duck": "on",
    "keySource": "sidechain",
    "makeupDb": "default",
    "mixPct": "default",
    "kind": "default",
    "detectorOversampling": "default",
    "detectorTopology": "feedforward",
    "keyTiltDb": "default",
    "detectLink": "default",
    "releaseMode": "fixed"
  },
  "resourceHints": {
    "threads-spawned": 0,
    "streams-from-disk": false,
    "opens-sockets": false
  },
  "monitors": [
    "keyListen"
  ],
  "panel": {
    "family": "dynamics",
    "roles": {
      "threshold": "thresholdDb",
      "attack": "attackMs",
      "release": "releaseMs",
      "ratio": "ratio",
      "knee": "kneeDb"
    },
    "sections": [
      {
        "key": "duck",
        "label": "Duck",
        "controls": [
          "thresholdDb",
          "rangeDb",
          "ratio",
          "kneeDb"
        ]
      },
      {
        "key": "timing",
        "label": "Timing",
        "controls": [
          "attackMs",
          "holdMs",
          "releaseMs"
        ]
      },
      {
        "key": "key",
        "label": "Key",
        "controls": [
          "keyHpHz",
          "keyLpHz",
          "keyListen"
        ]
      }
    ]
  },
  "console": {
    "$comment": "The OpenMixer console ducks on its own comp slot with a key; racked as a plugin in a channel insert rack, the ducker is drawn by the generic plugin editor with this panel.",
    "placement": {
      "group": "plugins"
    }
  },
  "face": "comp"
}
