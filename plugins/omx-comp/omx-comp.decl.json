{
  "$comment": "The extras of omx-comp's declaration: what its descriptor, omx-comp.descriptor.json, has no word for (docs/declaration-as-descriptor.md). The two are the folder's hand-written files; tools/gen.mjs generates the rest and writes the travels the descriptor's links resolve to. Its parameters are by reference to omx-contract's comp kernel and bind by name to omx-dsp's instance face. Control order, the descriptor's, is append-only.",
  "stem": "omx-comp",
  "kernel": "comp",
  "kernels": [
    "comp"
  ],
  "url": "https://github.com/FreeMixer/omx-plugins",
  "binding": "instance",
  "controls": {
    "detectorTopology": {
      "values": [
        "Feedforward",
        "Feedback"
      ]
    }
  },
  "portHints": {
    "thresholdDb": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:db"
    },
    "kneeDb": {
      "unit": "units:db"
    },
    "attackMs": {
      "unit": "units:ms"
    },
    "releaseMs": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:ms"
    },
    "makeupDb": {
      "unit": "units:db"
    },
    "mixPct": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:pc"
    },
    "kind": {
      "props": [
        "lv2:enumeration",
        "lv2:integer"
      ],
      "points": [
        "0 Compressor",
        "1 Limiter"
      ]
    },
    "detectorOversampling": {
      "props": [
        "lv2:enumeration",
        "lv2:integer"
      ],
      "points": [
        "0 Auto",
        "1 Off",
        "2 4x"
      ]
    },
    "detectorTopology": {
      "props": [
        "lv2:enumeration",
        "lv2:integer"
      ],
      "points": [
        "0 Feedforward",
        "1 Feedback"
      ]
    },
    "enabled": {
      "props": [
        "lv2:toggled"
      ]
    },
    "latency": {
      "props": [
        "lv2:integer",
        "lv2:reportsLatency"
      ],
      "unit": "units:frame"
    }
  },
  "meters": [
    {
      "id": "compGr",
      "kind": "gain_reduction",
      "field": "st.gr_min_db",
      "readout": "GAIN_REDUCTION_DB"
    },
    {
      "id": "compIn",
      "kind": "level",
      "source": "input",
      "min": -60,
      "max": 6
    },
    {
      "id": "compOut",
      "kind": "level",
      "source": "output",
      "min": -60,
      "max": 6
    }
  ],
  "panel": {
    "family": "dynamics",
    "roles": {
      "threshold": "thresholdDb",
      "ratio": "ratio",
      "attack": "attackMs",
      "release": "releaseMs",
      "knee": "kneeDb",
      "makeup": "makeupDb",
      "mix": "mixPct"
    },
    "sections": [
      {
        "key": "comp",
        "label": "Comp",
        "controls": [
          "thresholdDb",
          "ratio",
          "kneeDb",
          "attackMs",
          "releaseMs",
          "makeupDb",
          "mixPct",
          "kind",
          "detectorOversampling",
          "detectorTopology"
        ]
      }
    ]
  },
  "console": {
    "$comment": "The compressor as a dynamics stage of the console walk: one section of the ten controls, in declaration order. Its placement follows the other dynamics stages (gate, de-esser); the card, chip and graph the console draws for it are not declared yet.",
    "placement": {
      "strips": [
        "input",
        "fxReturn",
        "aux",
        "mix",
        "matrix",
        "main",
        "fxSend",
        "mixMinus"
      ],
      "group": "walk",
      "stage": "comp",
      "after": "deEsser",
      "fxGroup": "dynamics"
    }
  }
}
