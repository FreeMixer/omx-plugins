{
  "$schema": "https://github.com/FreeMixer/omx-contract/raw/v3/schema/omx-contract.schema.json",
  "requires": {
    "omx-contract-schema": ">= 3.0.0"
  },
  "origin": "authored",
  "plugin": {
    "id": "org.openmixer.comp",
    "format": "clap",
    "uri": "urn:openmixer:comp",
    "name": "omx comp",
    "vendor": "openmixer",
    "version": "0.15.1",
    "doc": "The console's compressor: threshold, ratio and knee set how hard it holds the level down, attack and release how fast, with makeup gain and a dry/wet mix. Kind picks the RMS detector (Compressor) or the peak detector (Limiter), and detector oversampling can run the control path at 4x; detector topology has it hear the input (feedforward) or its own output (feedback). The DSP is omx-dsp's <omxdsp/fx/omx_comp_instance.h>, the console's own compressor.",
    "features": [
      "audio-effect"
    ]
  },
  "controls": [
    {
      "id": 0,
      "symbol": "thresholdDb",
      "name": "Threshold",
      "kind": "travel",
      "travel": {
        "min": -60,
        "max": 0,
        "step": 1,
        "unit": "dB",
        "default": -18,
        "scale": "stepped"
      },
      "group": [
        "Comp"
      ],
      "meaning": "threshold",
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/comp.json#COMP_LIMITS.thresholdDb",
          "at": "omx-dsp@0.26.0"
        }
      }
    },
    {
      "id": 1,
      "symbol": "ratio",
      "name": "Ratio",
      "kind": "travel",
      "travel": {
        "min": 1,
        "max": 20,
        "step": 0,
        "unit": "ratio",
        "default": 4,
        "scale": "linear"
      },
      "group": [
        "Comp"
      ],
      "meaning": "ratio",
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/comp.json#COMP_LIMITS.ratio",
          "at": "omx-dsp@0.26.0"
        }
      }
    },
    {
      "id": 2,
      "symbol": "kneeDb",
      "name": "Knee",
      "kind": "travel",
      "travel": {
        "min": 0,
        "max": 24,
        "step": 0,
        "unit": "dB",
        "default": 6,
        "scale": "linear"
      },
      "group": [
        "Comp"
      ],
      "meaning": "knee",
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/comp.json#COMP_LIMITS.kneeDb",
          "at": "omx-dsp@0.26.0"
        }
      }
    },
    {
      "id": 3,
      "symbol": "attackMs",
      "name": "Attack",
      "kind": "travel",
      "travel": {
        "min": 0.1,
        "max": 100,
        "step": 0,
        "unit": "ms",
        "default": 5,
        "scale": "linear"
      },
      "group": [
        "Comp"
      ],
      "meaning": "attack",
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/comp.json#COMP_LIMITS.attackMs",
          "at": "omx-dsp@0.26.0"
        }
      }
    },
    {
      "id": 4,
      "symbol": "releaseMs",
      "name": "Release",
      "kind": "travel",
      "travel": {
        "min": 5,
        "max": 3000,
        "step": 1,
        "unit": "ms",
        "default": 200,
        "scale": "stepped"
      },
      "group": [
        "Comp"
      ],
      "meaning": "release",
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/comp.json#COMP_LIMITS.releaseMs",
          "at": "omx-dsp@0.26.0"
        }
      }
    },
    {
      "id": 5,
      "symbol": "makeupDb",
      "name": "Makeup",
      "kind": "travel",
      "travel": {
        "min": 0,
        "max": 24,
        "step": 0,
        "unit": "dB",
        "default": 0,
        "scale": "linear"
      },
      "group": [
        "Comp"
      ],
      "meaning": "makeup",
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/comp.json#COMP_LIMITS.makeupDb",
          "at": "omx-dsp@0.26.0"
        }
      }
    },
    {
      "id": 6,
      "symbol": "mixPct",
      "name": "Mix",
      "kind": "travel",
      "travel": {
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "default": 100,
        "scale": "stepped"
      },
      "group": [
        "Comp"
      ],
      "meaning": "wetDryRatio",
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/comp.json#COMP_LIMITS.mixPct",
          "at": "omx-dsp@0.26.0"
        }
      }
    },
    {
      "id": 7,
      "symbol": "kind",
      "name": "Kind",
      "kind": "choice",
      "ids": [
        "0",
        "1"
      ],
      "labels": [
        "Compressor",
        "Limiter"
      ],
      "values": [
        0,
        1
      ],
      "default": "0",
      "group": [
        "Comp"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/comp.json#COMP_KINDS",
          "at": "omx-dsp@0.26.0"
        }
      }
    },
    {
      "id": 8,
      "symbol": "detectorOversampling",
      "name": "Detector Oversampling",
      "kind": "choice",
      "ids": [
        "0",
        "1",
        "2"
      ],
      "labels": [
        "Auto",
        "Off",
        "4x"
      ],
      "values": [
        0,
        1,
        2
      ],
      "default": "0",
      "group": [
        "Comp"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/comp.json#DETECTOR_OVERSAMPLINGS",
          "at": "omx-dsp@0.26.0"
        }
      }
    },
    {
      "id": 9,
      "symbol": "detectorTopology",
      "name": "Detector Topology",
      "kind": "choice",
      "ids": [
        "0",
        "1"
      ],
      "labels": [
        "Feedforward",
        "Feedback"
      ],
      "values": [
        0,
        1
      ],
      "default": "0",
      "group": [
        "Comp"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/comp.json#DETECTOR_TOPOLOGY",
          "at": "omx-dsp@0.26.0"
        }
      }
    }
  ],
  "ports": [
    {
      "id": 0,
      "name": "in",
      "kind": "audio",
      "direction": "in",
      "role": "main",
      "channels": 2,
      "layout": "stereo"
    },
    {
      "id": 0,
      "name": "out",
      "kind": "audio",
      "direction": "out",
      "role": "main",
      "channels": 2,
      "layout": "stereo"
    }
  ],
  "needs": {
    "extensions": {
      "optional": [
        "lv2:hardRTCapable"
      ]
    }
  },
  "latency": {
    "reports": true
  },
  "extensions": {
    "clap": {
      "clap_plugin_descriptor.features": [
        "CLAP_PLUGIN_FEATURE_COMPRESSOR",
        "CLAP_PLUGIN_FEATURE_STEREO"
      ]
    },
    "lv2": {
      "rdf:type": [
        "lv2:Plugin",
        "lv2:CompressorPlugin"
      ]
    }
  },
  "source": {
    "impl": "plugins/omx-comp/omx_comp_clap.c#clap_entry"
  }
}
