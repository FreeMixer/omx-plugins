{
  "$schema": "https://github.com/FreeMixer/omx-contract/raw/v3/schema/omx-contract.schema.json",
  "requires": {
    "omx-contract-schema": ">= 3.0.0"
  },
  "origin": "authored",
  "plugin": {
    "id": "org.openmixer.suboct",
    "format": "clap",
    "uri": "urn:openmixer:suboct",
    "name": "omx suboct",
    "vendor": "openmixer",
    "version": "0.16.0",
    "doc": "Adds a note one or two octaves below a single played line, by dividing its pitch, with a tracking range and a gate for quiet input.",
    "features": [
      "audio-effect"
    ]
  },
  "controls": [
    {
      "id": 0,
      "symbol": "range",
      "name": "Range",
      "kind": "choice",
      "ids": [
        "0",
        "1",
        "2"
      ],
      "labels": [
        "Low",
        "Mid",
        "High"
      ],
      "values": [
        0,
        1,
        2
      ],
      "default": "0",
      "group": [
        "Suboct"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/suboct.json#SUBOCT_RANGES",
          "at": "omx-dsp@0.27.0"
        }
      }
    },
    {
      "id": 1,
      "symbol": "oct1",
      "name": "Oct1",
      "kind": "travel",
      "travel": {
        "min": 0,
        "max": 100,
        "step": 0,
        "unit": "%",
        "default": 100,
        "scale": "linear"
      },
      "group": [
        "Suboct"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/suboct.json#SUBOCT_OCT1_RANGE",
          "at": "omx-dsp@0.27.0"
        }
      }
    },
    {
      "id": 2,
      "symbol": "oct2",
      "name": "Oct2",
      "kind": "travel",
      "travel": {
        "min": 0,
        "max": 100,
        "step": 0,
        "unit": "%",
        "default": 0,
        "scale": "linear"
      },
      "group": [
        "Suboct"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/suboct.json#SUBOCT_OCT2_RANGE",
          "at": "omx-dsp@0.27.0"
        }
      }
    },
    {
      "id": 3,
      "symbol": "dry",
      "name": "Dry",
      "kind": "travel",
      "travel": {
        "min": 0,
        "max": 100,
        "step": 0,
        "unit": "%",
        "default": 100,
        "scale": "linear"
      },
      "group": [
        "Suboct"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/suboct.json#SUBOCT_DRY_RANGE",
          "at": "omx-dsp@0.27.0"
        }
      }
    },
    {
      "id": 4,
      "symbol": "trackGateDb",
      "name": "Track Gate",
      "kind": "travel",
      "travel": {
        "min": -80,
        "max": -20,
        "step": 0,
        "unit": "dBFS",
        "default": -50,
        "scale": "linear"
      },
      "group": [
        "Suboct"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/suboct.json#SUBOCT_TRACK_GATE_DB_RANGE",
          "at": "omx-dsp@0.27.0"
        }
      }
    }
  ],
  "ports": [
    {
      "id": 0,
      "name": "in",
      "kind": "audio",
      "direction": "in",
      "role": "main",
      "channels": 2,
      "layout": "stereo"
    },
    {
      "id": 0,
      "name": "out",
      "kind": "audio",
      "direction": "out",
      "role": "main",
      "channels": 2,
      "layout": "stereo"
    }
  ],
  "needs": {
    "extensions": {
      "optional": [
        "lv2:hardRTCapable"
      ]
    }
  },
  "latency": {
    "reports": true
  },
  "extensions": {
    "clap": {
      "clap_plugin_descriptor.features": [
        "CLAP_PLUGIN_FEATURE_PITCH_SHIFTER",
        "CLAP_PLUGIN_FEATURE_STEREO"
      ]
    },
    "lv2": {
      "rdf:type": [
        "lv2:Plugin",
        "lv2:PitchPlugin"
      ]
    }
  },
  "source": {
    "impl": "plugins/omx-suboct/omx_suboct_clap.c#clap_entry"
  }
}
