{
  "$comment": "The extras of omx-loudlevel's declaration: what its descriptor, omx-loudlevel.descriptor.json, has no word for (docs/declaration-as-descriptor.md). The two are the folder's hand-written files; tools/gen.mjs generates the rest and writes the travels the descriptor's links resolve to. Its parameters are by reference to omx-contract's loudlevel kernel and bind by name to omx-dsp's instance face. Control order, the descriptor's, is append-only.",
  "stem": "omx-loudlevel",
  "kernel": "loudlevel",
  "kernels": [
    "loudlevel"
  ],
  "noun": "loudness leveler",
  "engaged": {
    "rangeDb": 24
  },
  "stretch": 256,
  "liveStretch": 8,
  "sabotageStep": {
    "gateLufs": 15
  },
  "url": "https://github.com/FreeMixer/omx-plugins",
  "binding": "instance",
  "panel": {
    "family": "none",
    "roles": {},
    "sections": [
      {
        "key": "loudlevel",
        "label": "Loudlevel",
        "controls": [
          "targetLufs",
          "rangeDb",
          "speedDbPerS",
          "gateLufs",
          "window"
        ]
      }
    ]
  },
  "console": {
    "$comment": "The OpenMixer console has no loudness leveler stage. Racked as a plugin in a channel's insert rack, it is drawn by the generic plugin editor.",
    "placement": {
      "strips": [
        "input",
        "fxReturn",
        "aux",
        "mix",
        "matrix",
        "main"
      ],
      "group": "plugins"
    }
  },
  "portHints": {
    "targetLufs": {
      "unit": "units:db"
    },
    "rangeDb": {
      "unit": "units:db"
    },
    "speedDbPerS": {
      "unit": "units:db"
    },
    "gateLufs": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:db"
    },
    "window": {
      "props": [
        "lv2:enumeration",
        "lv2:integer"
      ],
      "points": [
        "0 Momentary",
        "1 Short-term"
      ]
    },
    "enabled": {
      "props": [
        "lv2:toggled"
      ]
    },
    "latency": {
      "props": [
        "lv2:integer",
        "lv2:reportsLatency"
      ],
      "unit": "units:frame"
    }
  }
}
