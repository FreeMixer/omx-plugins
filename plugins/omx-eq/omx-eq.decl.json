{
  "$comment": "THE declaration of the channel EQ's three plugins, omx-eq8, omx-eq16 and omx-eq32: ONE file for three band counts (tools/variants.mjs), the folders plugins/omx-eq8, omx-eq16 and omx-eq32 hold only what tools/gen.mjs writes from it. Its parameters are by reference to omx-contract's eq kernel and bind by name to omx-dsp's instance face; the per-band ones repeat for every band. Parameter order is append-only.",
  "stem": "omx-eq",
  "kernel": "eq",
  "kernels": [
    "eq"
  ],
  "variants": {
    "count": "EQ_BAND_COUNTS",
    "of": [
      {
        "stem": "omx-eq8",
        "count": "eq8"
      },
      {
        "stem": "omx-eq16",
        "count": "eq16"
      },
      {
        "stem": "omx-eq32",
        "count": "eq32"
      }
    ]
  },
  "name": "omx eq",
  "noun": "{bands}-band EQ",
  "vendor": "openmixer",
  "url": "https://github.com/FreeMixer/omx-plugins",
  "version": "0.3.0",
  "description": "The OpenMixer console's channel EQ, {bands}-band form: {bands} parametric bands (bell, shelves, notch, all-pass) and a high-pass and a low-pass filter at 12 or 24 dB/oct, stereo, zero latency; every band ships off, so a racked instance is a wire.",
  "summary": "The console's channel EQ in its {bands}-band form: {bands} parametric bands (bell, shelves, notch, all-pass) plus high- and low-pass filters at 12 or 24 dB/oct. Stereo, zero latency, 44.1 to 192 kHz.",
  "clap": {
    "id": "org.openmixer.eq",
    "features": [
      "audio-effect",
      "equalizer",
      "stereo"
    ]
  },
  "lv2": {
    "uri": "urn:openmixer:eq",
    "class": "lv2:ParaEQPlugin"
  },
  "binding": "instance",
  "params": [
    {
      "symbol": "hpf_on",
      "name": "HPF On",
      "ref": "EQ_HPF_ONS"
    },
    {
      "symbol": "hpf_freq",
      "name": "HPF Frequency",
      "ref": "HPF_FREQ_RANGE",
      "defaultRef": "EQ_PASS_FILTER_DEFAULTS.hpfFreqHz"
    },
    {
      "symbol": "hpf_slope",
      "name": "HPF Slope",
      "ref": "FILTER_SLOPES",
      "unit": "dB/oct"
    },
    {
      "symbol": "lpf_on",
      "name": "LPF On",
      "ref": "EQ_LPF_ONS"
    },
    {
      "symbol": "lpf_freq",
      "name": "LPF Frequency",
      "ref": "LPF_FREQ_RANGE",
      "defaultRef": "EQ_PASS_FILTER_DEFAULTS.lpfFreqHz"
    },
    {
      "symbol": "lpf_slope",
      "name": "LPF Slope",
      "ref": "FILTER_SLOPES",
      "unit": "dB/oct"
    },
    {
      "symbol": "type",
      "name": "Type",
      "ref": "EQ_BAND_TYPES",
      "perBand": true,
      "defaultBand": {
        "of": "type"
      }
    },
    {
      "symbol": "freq",
      "name": "Frequency",
      "ref": "EQ_FREQ_RANGE",
      "perBand": true,
      "defaultBand": {
        "of": "centre"
      }
    },
    {
      "symbol": "gain",
      "name": "Gain",
      "ref": "EQ_GAIN_RANGE",
      "perBand": true,
      "defaultRef": "EQ_BAND_DEFAULTS.gainDb"
    },
    {
      "symbol": "q",
      "name": "Q",
      "ref": "EQ_Q_RANGE",
      "perBand": true,
      "defaultRef": "EQ_BAND_DEFAULTS.q"
    },
    {
      "symbol": "on",
      "name": "On",
      "ref": "EQ_BAND_ONS",
      "perBand": true
    }
  ],
  "portHints": {
    "hpf_on": {
      "props": [
        "lv2:toggled"
      ]
    },
    "hpf_freq": {
      "props": [
        "lv2:integer",
        "pprops:logarithmic"
      ],
      "unit": "units:hz"
    },
    "hpf_slope": {
      "props": [
        "lv2:enumeration",
        "lv2:integer"
      ],
      "points": [
        "12 12 dB/oct",
        "24 24 dB/oct"
      ]
    },
    "lpf_on": {
      "props": [
        "lv2:toggled"
      ]
    },
    "lpf_freq": {
      "props": [
        "lv2:integer",
        "pprops:logarithmic"
      ],
      "unit": "units:hz"
    },
    "lpf_slope": {
      "props": [
        "lv2:enumeration",
        "lv2:integer"
      ],
      "points": [
        "12 12 dB/oct",
        "24 24 dB/oct"
      ]
    },
    "type": {
      "props": [
        "lv2:enumeration",
        "lv2:integer"
      ],
      "points": [
        "0 Bell",
        "1 Low Shelf",
        "2 High Shelf",
        "3 Notch",
        "4 All-pass 1st",
        "5 All-pass 2nd"
      ]
    },
    "freq": {
      "props": [
        "lv2:integer",
        "pprops:logarithmic"
      ],
      "unit": "units:hz"
    },
    "gain": {
      "unit": "units:db"
    },
    "on": {
      "props": [
        "lv2:toggled"
      ]
    },
    "enabled": {
      "props": [
        "lv2:toggled"
      ]
    },
    "latency": {
      "props": [
        "lv2:integer",
        "lv2:reportsLatency"
      ],
      "unit": "units:frame"
    }
  },
  "panel": {
    "family": "eq",
    "roles": {},
    "sections": [
      {
        "key": "eq",
        "label": "EQ",
        "controls": [
          "hpf_on",
          "hpf_freq",
          "hpf_slope",
          "lpf_on",
          "lpf_freq",
          "lpf_slope",
          "type",
          "freq",
          "gain",
          "q",
          "on"
        ]
      }
    ]
  },
  "manual": [
    "| Section | Parameters |",
    "|---|---|",
    "| High-pass | on/off, 20 to 1000 Hz, 12 or 24 dB/oct |",
    "| Low-pass | on/off, 1 to 20 kHz, 12 or 24 dB/oct |",
    "| Bands 1 to {bands} | each on/off, type, frequency (20 Hz to 20 kHz), gain (±15 dB), Q (0.3 to 8, a notch to 116) |",
    "",
    "Plus the host's bypass, which is the whole EQ's switch. Every band and filter starts off, so a freshly loaded instance passes the",
    "signal untouched."
  ],
  "console": {
    "$comment": "As FreeMixer/openmixer integration/waves-2026-10 draws its eq stage: EqCurve over EqEncoderBank.vue, a chip per band (on, type, freq, gain, q) plus the HPF and LPF (on, slope, cutoff); the console's bands are a list the operator adds to, these variants' are fixed. Chip: STAGE_CHIP_PARAMS.eq, shown while the HPF is on. Card: one gain per band, then the HPF frequency (useStripOverview).",
    "placement": {
      "strips": [
        "input",
        "fxReturn",
        "aux",
        "mix",
        "matrix",
        "main",
        "fxSend",
        "mixMinus"
      ],
      "group": "walk",
      "stage": "eq",
      "after": "gate",
      "fxGroup": "eq"
    },
    "card": {
      "show": [
        "gain",
        "hpf_freq"
      ]
    },
    "chip": "HPF {hpf_freq}",
    "panel": {
      "sections": [
        {
          "key": "bands",
          "label": "Bands",
          "controls": [
            "on",
            "type",
            "freq",
            "gain",
            "q"
          ],
          "graph": "eq-curve"
        },
        {
          "key": "hpf",
          "label": "HPF",
          "controls": [
            "hpf_on",
            "hpf_slope",
            "hpf_freq"
          ]
        },
        {
          "key": "lpf",
          "label": "LPF",
          "controls": [
            "lpf_on",
            "lpf_slope",
            "lpf_freq"
          ]
        }
      ]
    }
  }
}
