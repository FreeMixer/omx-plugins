{
  "$comment": "THE declaration of omx-flanger, the folder's one hand-written file. Every other file of the folder is generated from it by tools/gen.mjs. Its parameters are by reference to omx-contract's flanger kernel and bind by name to omx-dsp's instance face. Parameter order is append-only.",
  "stem": "omx-flanger",
  "kernel": "flanger",
  "kernels": [
    "flanger"
  ],
  "name": "omx flanger",
  "vendor": "openmixer",
  "url": "https://github.com/FreeMixer/omx-plugins",
  "version": "0.2.0",
  "description": "The console's flanger: one modulated short delay with signed feedback, swept by one oscillator and mixed with the dry signal.",
  "clap": {
    "id": "org.openmixer.flanger",
    "features": [
      "audio-effect",
      "flanger",
      "stereo"
    ]
  },
  "lv2": {
    "uri": "urn:openmixer:flanger",
    "class": "lv2:FlangerPlugin"
  },
  "binding": "instance",
  "params": [
    {
      "symbol": "rate",
      "name": "Rate",
      "ref": "FLANGER_RATE_RANGE"
    },
    {
      "symbol": "depth",
      "name": "Depth",
      "ref": "FLANGER_DEPTH_RANGE"
    },
    {
      "symbol": "feedback",
      "name": "Feedback",
      "ref": "FLANGER_FEEDBACK_RANGE"
    },
    {
      "symbol": "mix",
      "name": "Mix",
      "ref": "FLANGER_MIX_RANGE"
    }
  ],
  "portHints": {
    "rate": {
      "props": [
        "pprops:logarithmic"
      ],
      "unit": "units:hz"
    },
    "depth": {
      "unit": "units:ms"
    },
    "mix": {
      "unit": "units:pc"
    },
    "enabled": {
      "props": [
        "lv2:toggled"
      ]
    },
    "latency": {
      "props": [
        "lv2:integer",
        "lv2:reportsLatency"
      ],
      "unit": "units:frame"
    }
  }
}
