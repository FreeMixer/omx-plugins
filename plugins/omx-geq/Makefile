#!/usr/bin/make -f
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 Pau Aliagas <linuxnow@gmail.com>
# GENERATED by tools/gen.mjs from plugins/omx-geq/omx-geq.decl.json — DO NOT EDIT BY HAND.
#
# omx-geq as CLAP and LV2, in plain C, from ONE declaration (omx-geq.decl.json).
#
#   make            build/omx-geq.clap and build/omx-geq.lv2/ (binary, TTL, MOD GUI)
#   make test       freshness of every generated file, the parameters as declared, every parameter
#                   live, the geq kernel-identity oracle, the panel description both faces serve, the
#                   CLAP face's parameter contract, remote controls and track-info, the LV2 port
#                   groups, the MOD GUI checks, and the host checks (omx-clap-scan, lv2info) where
#                   installed
#   make gen        regenerate generated/ from the declaration (commit the result)
#   make install    DESTDIR/PREFIX/LIBDIR/CLAPDIR: $(CLAPDIR)/omx-geq.clap, $(LIBDIR)/lv2/omx-geq.lv2/
#
# Build deps: omx-dsp (pkg-config omxdsp, >= OMXDSP_MIN), omx-clap-core (the CLAP ABI's openmixer
# extensions), clap, lv2; for the tests lilv and node.

NAME       := omx-geq
URI        := urn:openmixer:geq
CLAP_ID    := org.openmixer.geq
OMXDSP_MIN ?= 0.5.2
ROOT       := $(abspath ../..)
GEN        := generated
B          := build
BUNDLE     := $(B)/$(NAME).lv2

PKG_CONFIG ?= pkg-config
ifeq ($(shell $(PKG_CONFIG) --atleast-version=$(OMXDSP_MIN) omxdsp && echo y),)
$(error omx-dsp >= $(OMXDSP_MIN) not found by `$(PKG_CONFIG) omxdsp`: install omx-dsp-devel (see BUILDING.md))
endif
DSP_CFLAGS := $(shell $(PKG_CONFIG) --cflags omxdsp)
DSP_LIBS   := $(shell $(PKG_CONFIG) --libs omxdsp)
ABI_CFLAGS := $(shell $(PKG_CONFIG) --cflags omx-clap-core clap 2>/dev/null)
LV2_CFLAGS := $(shell $(PKG_CONFIG) --cflags lv2 2>/dev/null)
LILV       := $(shell $(PKG_CONFIG) --cflags --libs lilv-0 2>/dev/null)

CC      ?= cc
CFLAGS  ?= -O2 -g
WARN    := -std=gnu11 -Wall -Wextra -Werror
PLUGIN  := -fPIC -shared -Wl,-z,defs -fvisibility=hidden -I$(GEN) -I$(ROOT)/include $(DSP_CFLAGS)
LDLIBS  := $(DSP_LIBS)

PREFIX  ?= /usr
LIBDIR  ?= $(PREFIX)/lib
# the path the CLAP specification gives Linux distributions, on every distribution and architecture
CLAPDIR ?= $(PREFIX)/lib/clap

TTL      := $(GEN)/$(NAME).lv2
TTL_SRCS := $(shell find $(TTL) -type f 2>/dev/null)
CORE     := omx_geq_core.h $(GEN)/omx_geq_params.h $(ROOT)/include/omx_panel_description.h \
            $(ROOT)/include/omx_param_contract.h

all: $(B)/$(NAME).clap $(BUNDLE)/$(NAME).so $(BUNDLE)/manifest.ttl

$(B)/$(NAME).clap: omx_geq_clap.c $(CORE) | $(B)
	$(CC) $(CPPFLAGS) $(CFLAGS) $(WARN) $(PLUGIN) $(ABI_CFLAGS) -o $@ $< $(LDFLAGS) $(LDLIBS)

$(BUNDLE)/$(NAME).so: omx_geq_lv2.c $(CORE) | $(B)
	@mkdir -p $(BUNDLE)
	$(CC) $(CPPFLAGS) $(CFLAGS) $(WARN) $(PLUGIN) $(LV2_CFLAGS) -o $@ $< $(LDFLAGS) $(LDLIBS)

# The bundle's text and images are generated and committed; the build copies them beside the binary.
$(BUNDLE)/manifest.ttl: $(TTL_SRCS) | $(B)
	@mkdir -p $(BUNDLE)
	cp -r $(TTL)/. $(BUNDLE)/

$(B):
	@mkdir -p $@

$(B)/clap-probe: $(ROOT)/tools/clap-probe.c | $(B)
	$(CC) $(CFLAGS) $(WARN) $(ABI_CFLAGS) -o $@ $< -ldl

$(B)/panel-probe: $(ROOT)/tools/panel-probe.c $(ROOT)/include/omx_panel_description.h | $(B)
	$(CC) $(CFLAGS) $(WARN) -I$(ROOT)/include $(ABI_CFLAGS) -o $@ $< $(LILV) -ldl

$(B)/clap-ext-probe: $(ROOT)/tools/clap-ext-probe.c $(ROOT)/include/omx_param_contract.h | $(B)
	$(CC) $(CFLAGS) $(WARN) -I$(ROOT)/include $(ABI_CFLAGS) -o $@ $< -ldl

$(B)/port-groups-probe: $(ROOT)/tools/port-groups-probe.c | $(B)
	$(CC) $(CFLAGS) $(WARN) -o $@ $< $(LILV)

$(B)/geq-oracle: test/geq-oracle.c $(CORE) | $(B)
	$(CC) $(CFLAGS) $(WARN) -I$(GEN) -I$(ROOT)/include $(DSP_CFLAGS) $(ABI_CFLAGS) -o $@ $< $(LILV) -ldl $(LDLIBS)

gen:
	node $(ROOT)/tools/gen.mjs $(CURDIR)
	node $(ROOT)/tools/modgui-gen.mjs $(CURDIR)

check:
	node $(ROOT)/tools/gen.mjs --check $(CURDIR)
	node $(ROOT)/tools/modgui-gen.mjs --check $(CURDIR)

# The parameter test: the built CLAP face's parameters are the declaration's, and every one of them
# reaches the kernel. The kernel-identity test: both faces, sample for sample, against omx-dsp's
# geq kernel called directly. The panel test: org.openmixer.panel-description/1 read from
# each built face as a host reads it, equal to the declaration's panel. The CLAP extension test: the
# parameter contract, the remote-control pages and each placement's defaults, read as a host reads
# them, equal to the declaration's. The port-group test: the LV2 bundle, read through lilv, puts each
# panel section's parameters in that section's pg:Group. Every test runs, and the target fails if any
# failed, so a new plugin shows all its red tests at once.
test: all check $(B)/clap-probe $(B)/panel-probe $(B)/clap-ext-probe $(B)/port-groups-probe $(B)/geq-oracle
	@fail=0; \
	$(B)/clap-probe params $(B)/$(NAME).clap > $(B)/clap-params.txt && \
	  node $(ROOT)/tools/clap-params-check.mjs $(CURDIR) $(B)/clap-params.txt || fail=1; \
	$(B)/clap-probe live $(B)/$(NAME).clap || fail=1; \
	$(B)/geq-oracle clap $(B)/$(NAME).clap || fail=1; \
	$(B)/geq-oracle lv2 $(BUNDLE) $(URI) || fail=1; \
	$(B)/panel-probe clap $(B)/$(NAME).clap > $(B)/panel-clap.txt && \
	  node $(ROOT)/tools/panel-check.mjs $(CURDIR) clap $(B)/panel-clap.txt || fail=1; \
	$(B)/panel-probe lv2 $(BUNDLE) $(URI) > $(B)/panel-lv2.txt && \
	  node $(ROOT)/tools/panel-check.mjs $(CURDIR) lv2 $(B)/panel-lv2.txt || fail=1; \
	$(B)/clap-ext-probe $(B)/$(NAME).clap > $(B)/clap-ext.txt && \
	  node $(ROOT)/tools/clap-ext-check.mjs $(CURDIR) $(B)/clap-ext.txt || fail=1; \
	$(B)/port-groups-probe $(BUNDLE) $(URI) > $(B)/port-groups.txt && \
	  node $(ROOT)/tools/port-groups-check.mjs $(CURDIR) $(B)/port-groups.txt || fail=1; \
	sh $(ROOT)/tools/modgui-test.sh $(CURDIR) || fail=1; \
	sh $(ROOT)/tools/host-check.sh $(B)/$(NAME).clap $(BUNDLE) $(URI) $(CLAP_ID) || fail=1; \
	exit $$fail

install: all
	install -Dm755 $(B)/$(NAME).clap $(DESTDIR)$(CLAPDIR)/$(NAME).clap
	mkdir -p $(DESTDIR)$(LIBDIR)/lv2
	cp -r $(BUNDLE) $(DESTDIR)$(LIBDIR)/lv2/

clean:
	rm -rf $(B)

.PHONY: all gen check test install clean
