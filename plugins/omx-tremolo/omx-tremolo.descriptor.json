      "meaning": "rate",
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/tremolo.json#TREMOLO_RATE_RANGE",
          "at": "omx-dsp@0.22.0"
        }
      }
    },
    {
      "id": 1,
      "symbol": "depth",
      "name": "Depth",
      "kind": "travel",
      "travel": {
        "min": 0,
        "max": 100,
        "step": 0,
        "unit": "%",
        "default": 50,
        "scale": "linear"
      },
      "group": [
        "Tremolo"
      ],
      "meaning": "depth",
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/tremolo.json#TREMOLO_DEPTH_RANGE",
          "at": "omx-dsp@0.22.0"
        }
      }
    },
    {
      "id": 2,
      "symbol": "mix",
      "name": "Mix",
      "kind": "travel",
      "travel": {
        "min": 0,
        "max": 100,
        "step": 0,
        "unit": "%",
        "default": 100,
        "scale": "linear"
      },
      "group": [
        "Tremolo"
      ],
      "meaning": "wetDryRatio",
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/tremolo.json#TREMOLO_MIX_RANGE",
          "at": "omx-dsp@0.22.0"
        }
      }
    },
    {
      "id": 3,
      "symbol": "mode",
      "name": "Mode",
      "kind": "choice",
      "ids": [
        "0",
        "1"
