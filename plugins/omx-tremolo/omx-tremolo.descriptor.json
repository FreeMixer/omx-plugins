{
  "$schema": "https://github.com/FreeMixer/omx-contract/raw/v2/schema/omx-contract.schema.json",
  "requires": {
    "omx-contract-schema": ">= 2.15.0"
  },
  "origin": "authored",
  "plugin": {
    "id": "org.openmixer.tremolo",
    "format": "clap",
