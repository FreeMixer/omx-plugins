{
  "$comment": "THE declaration of omx-tremolo, the folder's one hand-written file. Every other file of the folder is generated from it by tools/gen.mjs. Its parameters are by reference to omx-contract's tremolo kernel and bind by name to omx-dsp's instance face. Parameter order is append-only.",
  "stem": "omx-tremolo",
  "kernel": "tremolo",
  "kernels": [
    "tremolo"
  ],
  "name": "omx tremolo",
  "vendor": "openmixer",
  "url": "https://github.com/FreeMixer/omx-plugins",
  "version": "0.2.0",
  "description": "The console's tremolo and auto-pan: one oscillator turned into a level change on both legs, or into a left-right pan.",
  "clap": {
    "id": "org.openmixer.tremolo",
    "features": [
      "audio-effect",
      "tremolo",
      "stereo"
    ]
  },
  "lv2": {
    "uri": "urn:openmixer:tremolo",
    "class": "lv2:ModulatorPlugin"
  },
  "binding": "instance",
  "params": [
    {
      "symbol": "rateHz",
      "name": "Rate",
      "ref": "TREMOLO_RATE_RANGE"
    },
    {
      "symbol": "depth",
      "name": "Depth",
      "ref": "TREMOLO_DEPTH_RANGE"
    },
    {
      "symbol": "mix",
      "name": "Mix",
      "ref": "TREMOLO_MIX_RANGE"
    },
    {
      "symbol": "mode",
      "name": "Mode",
      "ref": "TREMOLO_MODES",
      "values": [
        "Tremolo",
        "Pan"
      ]
    }
  ],
  "portHints": {
    "rateHz": {
      "props": [
        "pprops:logarithmic"
      ],
      "unit": "units:hz"
    },
    "depth": {
      "unit": "units:pc"
    },
    "mix": {
      "unit": "units:pc"
    },
    "mode": {
      "props": [
        "lv2:enumeration",
        "lv2:integer"
      ],
      "points": [
        "0 Tremolo",
        "1 Pan"
      ]
    },
    "enabled": {
      "props": [
        "lv2:toggled"
      ]
    },
    "latency": {
      "props": [
        "lv2:integer",
        "lv2:reportsLatency"
      ],
      "unit": "units:frame"
    }
  }
}
