{
  "$comment": "THE declaration of omx-phaser, the folder's one hand-written file. Every other file of the folder is generated from it by tools/gen.mjs. Its parameters are by reference to omx-contract's phaser kernel and bind by name to omx-dsp's instance face. Parameter order is append-only.",
  "stem": "omx-phaser",
  "kernel": "phaser",
  "kernels": [
    "phaser"
  ],
  "name": "omx phaser",
  "vendor": "openmixer",
  "url": "https://github.com/FreeMixer/omx-plugins",
  "version": "0.3.0",
  "description": "The console's phaser: identical all-pass sections swept in octaves by one oscillator, with feedback around the chain and a wet/dry mix.",
  "clap": {
    "id": "org.openmixer.phaser",
    "features": [
      "audio-effect",
      "phaser",
      "stereo"
    ]
  },
  "lv2": {
    "uri": "urn:openmixer:phaser",
    "class": "lv2:PhaserPlugin"
  },
  "binding": "instance",
  "params": [
    {
      "symbol": "rateHz",
      "name": "Rate",
      "ref": "PHASER_RATE_RANGE"
    },
    {
      "symbol": "baseHz",
      "name": "Base",
      "ref": "PHASER_BASE_RANGE"
    },
    {
      "symbol": "depthOct",
      "name": "Depth",
      "ref": "PHASER_DEPTH_RANGE"
    },
    {
      "symbol": "stages",
      "name": "Stages",
      "ref": "PHASER_STAGES_RANGE"
    },
    {
      "symbol": "feedback",
      "name": "Feedback",
      "ref": "PHASER_FEEDBACK_RANGE"
    },
    {
      "symbol": "mix",
      "name": "Mix",
      "ref": "PHASER_MIX_RANGE"
    }
  ],
  "portHints": {
    "rateHz": {
      "props": [
        "pprops:logarithmic"
      ],
      "unit": "units:hz"
    },
    "baseHz": {
      "props": [
        "lv2:integer",
        "pprops:logarithmic"
      ],
      "unit": "units:hz"
    },
    "depthOct": {
      "unit": "units:oct"
    },
    "stages": {
      "props": [
        "lv2:integer"
      ]
    },
    "mix": {
      "unit": "units:pc"
    },
    "enabled": {
      "props": [
        "lv2:toggled"
      ]
    },
    "latency": {
      "props": [
        "lv2:integer",
        "lv2:reportsLatency"
      ],
      "unit": "units:frame"
    }
  },
  "panel": {
    "family": "phaser",
    "roles": {},
    "sections": [
      {
        "key": "phaser",
        "label": "Phaser",
        "controls": [
          "rateHz",
          "baseHz",
          "depthOct",
          "stages",
          "feedback",
          "mix"
        ]
      }
    ]
  },
  "console": {
    "$comment": "The console has the phaser stage in its walk (packages/declarations/stages/phaser.json, \"contract\": null) and draws no panel, chip or card for it today; racked as a plugin it is drawn by the generic plugin editor.",
    "placement": {
      "strips": [
        "input",
        "fxReturn",
        "aux",
        "mix",
        "matrix",
        "main",
        "fxSend",
        "mixMinus"
      ],
      "group": "walk",
      "stage": "phaser",
      "after": "pitch",
      "fxGroup": "modulation"
    }
  }
}
