{
  "$comment": "THE declaration of omx-rotary, the folder's one hand-written file. Every other file of the folder is generated from it by tools/gen.mjs. Its parameters are by reference to omx-contract's rotary kernel and bind by name to omx-dsp's instance face. Parameter order is append-only.",
  "stem": "omx-rotary",
  "kernel": "rotary",
  "kernels": [
    "rotary"
  ],
  "name": "omx rotary",
  "vendor": "openmixer",
  "url": "https://github.com/FreeMixer/omx-plugins",
  "version": "0.2.0",
  "description": "The console's rotary speaker: a drum rotor on the low band and a horn rotor on the high band, with stop, slow and fast speeds, mixed with the dry signal.",
  "clap": {
    "id": "org.openmixer.rotary",
    "features": [
      "audio-effect",
      "stereo"
    ]
  },
  "lv2": {
    "uri": "urn:openmixer:rotary",
    "class": "lv2:Plugin"
  },
  "binding": "instance",
  "params": [
    {
      "symbol": "hornSlowHz",
      "name": "Horn Slow",
      "ref": "ROTARY_HORN_SLOW_RANGE"
    },
    {
      "symbol": "hornFastHz",
      "name": "Horn Fast",
      "ref": "ROTARY_HORN_FAST_RANGE"
    },
    {
      "symbol": "drumSlowHz",
      "name": "Drum Slow",
      "ref": "ROTARY_DRUM_SLOW_RANGE"
    },
    {
      "symbol": "drumFastHz",
      "name": "Drum Fast",
      "ref": "ROTARY_DRUM_FAST_RANGE"
    },
    {
      "symbol": "accel",
      "name": "Accel",
      "ref": "ROTARY_ACCEL_RANGE"
    },
    {
      "symbol": "balance",
      "name": "Balance",
      "ref": "ROTARY_BALANCE_RANGE"
    },
    {
      "symbol": "mix",
      "name": "Mix",
      "ref": "ROTARY_MIX_RANGE"
    },
    {
      "symbol": "speed",
      "name": "Speed",
      "ref": "ROTARY_SPEEDS",
      "values": [
        "Stop",
        "Slow",
        "Fast"
      ],
      "defaultId": "slow"
    }
  ],
  "portHints": {
    "hornSlowHz": {
      "props": [
        "pprops:logarithmic"
      ],
      "unit": "units:hz"
    },
    "hornFastHz": {
      "props": [
        "pprops:logarithmic"
      ],
      "unit": "units:hz"
    },
    "drumSlowHz": {
      "props": [
        "pprops:logarithmic"
      ],
      "unit": "units:hz"
    },
    "drumFastHz": {
      "props": [
        "pprops:logarithmic"
      ],
      "unit": "units:hz"
    },
    "balance": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:pc"
    },
    "mix": {
      "unit": "units:pc"
    },
    "speed": {
      "props": [
        "lv2:enumeration",
        "lv2:integer"
      ],
      "points": [
        "0 Stop",
        "1 Slow",
        "2 Fast"
      ]
    },
    "enabled": {
      "props": [
        "lv2:toggled"
      ]
    },
    "latency": {
      "props": [
        "lv2:integer",
        "lv2:reportsLatency"
      ],
      "unit": "units:frame"
    }
  },
  "panel": {
    "family": "rotary",
    "roles": {},
    "sections": [
      {
        "key": "rotary",
        "label": "Rotary",
        "controls": [
          "hornSlowHz",
          "hornFastHz",
          "drumSlowHz",
          "drumFastHz",
          "accel",
          "balance",
          "mix",
          "speed"
        ]
      }
    ]
  }
}
