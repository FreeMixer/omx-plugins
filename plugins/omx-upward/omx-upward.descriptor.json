{
  "$schema": "https://github.com/FreeMixer/omx-contract/raw/v3/schema/omx-contract.schema.json",
  "requires": {
    "omx-contract-schema": ">= 3.7.0"
  },
  "origin": "authored",
  "plugin": {
    "id": "org.openmixer.upward",
    "format": "clap",
    "uri": "urn:openmixer:upward",
    "name": "omx upward",
    "vendor": "openmixer",
    "version": "0.19.1",
    "doc": "Lifts what is quiet toward a threshold, by a ratio and up to a limit, and leaves the loud alone.",
    "features": [
      "audio-effect"
    ]
  },
  "controls": [
    {
      "id": 0,
      "symbol": "thresholdDb",
      "name": "Threshold",
      "kind": "travel",
      "travel": {
        "min": -70,
        "max": 0,
        "step": 0,
        "unit": "dB",
        "default": -40,
        "scale": "linear"
      },
      "group": [
        "Upward"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/upward.json#UPWARD_THRESHOLD_DB_RANGE",
          "at": "omx-dsp@0.31.0"
        }
      }
    },
    {
      "id": 1,
      "symbol": "ratio",
      "name": "Ratio",
      "kind": "travel",
      "travel": {
        "min": 1,
        "max": 10,
        "step": 0,
        "unit": "ratio",
        "default": 1,
        "scale": "linear"
      },
      "group": [
        "Upward"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/upward.json#UPWARD_RATIO_RANGE",
          "at": "omx-dsp@0.31.0"
        }
      }
    },
    {
      "id": 2,
      "symbol": "rangeDb",
      "name": "Range",
      "kind": "travel",
      "travel": {
        "min": 0,
        "max": 24,
        "step": 0,
        "unit": "dB",
        "default": 6,
        "scale": "linear"
      },
      "group": [
        "Upward"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/upward.json#UPWARD_RANGE_DB_RANGE",
          "at": "omx-dsp@0.31.0"
        }
      }
    },
    {
      "id": 3,
      "symbol": "attackMs",
      "name": "Attack",
      "kind": "travel",
      "travel": {
        "min": 0.1,
        "max": 100,
        "step": 0,
        "unit": "ms",
        "default": 5,
        "scale": "linear"
      },
      "group": [
        "Upward"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/upward.json#UPWARD_ATTACK_MS_RANGE",
          "at": "omx-dsp@0.31.0"
        }
      }
    },
    {
      "id": 4,
      "symbol": "releaseMs",
      "name": "Release",
      "kind": "travel",
      "travel": {
        "min": 5,
        "max": 3000,
        "step": 1,
        "unit": "ms",
        "default": 200,
        "scale": "stepped"
      },
      "group": [
        "Upward"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/upward.json#UPWARD_RELEASE_MS_RANGE",
          "at": "omx-dsp@0.31.0"
        }
      }
    }
  ],
  "ports": [
    {
      "id": 0,
      "name": "in",
      "kind": "audio",
      "direction": "in",
      "role": "main",
      "channels": 2,
      "layout": "stereo"
    },
    {
      "id": 0,
      "name": "out",
      "kind": "audio",
      "direction": "out",
      "role": "main",
      "channels": 2,
      "layout": "stereo"
    }
  ],
  "needs": {
    "extensions": {
      "optional": [
        "lv2:hardRTCapable"
      ]
    }
  },
  "latency": {
    "reports": true
  },
  "extensions": {
    "clap": {
      "clap_plugin_descriptor.features": [
        "CLAP_PLUGIN_FEATURE_COMPRESSOR",
        "CLAP_PLUGIN_FEATURE_STEREO"
      ]
    },
    "lv2": {
      "rdf:type": [
        "lv2:Plugin",
        "lv2:CompressorPlugin"
      ]
    }
  },
  "source": {
    "impl": "plugins/omx-upward/omx_upward_clap.c#clap_entry"
  }
}
