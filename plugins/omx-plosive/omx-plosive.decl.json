{
  "$comment": "The extras of omx-plosive's declaration: what its descriptor, omx-plosive.descriptor.json, has no word for (docs/declaration-as-descriptor.md). The two are the folder's hand-written files; tools/gen.mjs generates the rest and writes the travels the descriptor's links resolve to. Its parameters are by reference to omx-contract's plosive kernel and bind by name to omx-dsp's instance face. Control order, the descriptor's, is append-only.",
  "stem": "omx-plosive",
  "kernel": "plosive",
  "kernels": [
    "plosive"
  ],
  "noun": "plosive tamer",
  "url": "https://github.com/FreeMixer/omx-plugins",
  "binding": "instance",
  "resourceHints": {
    "threads-spawned": 0,
    "streams-from-disk": false,
    "opens-sockets": false
  },
  "panel": {
    "family": "none",
    "roles": {},
    "sections": [
      {
        "key": "plosive",
        "label": "Plosive",
        "controls": [
          "consonantDb",
          "sensitivityDb",
          "recoveryMs",
          "bandHz",
          "bandWidthOct",
          "popDb",
          "popSensitivityDb",
          "popRecoveryMs",
          "popHz"
        ]
      }
    ]
  },
  "console": {
    "$comment": "The OpenMixer console has no plosive stage. Racked as a plugin in a channel's insert rack, it is drawn by the generic plugin editor.",
    "placement": {
      "strips": [
        "input",
        "fxReturn",
        "aux",
        "mix",
        "matrix",
        "main"
      ],
      "group": "plugins"
    }
  },
  "portHints": {
    "consonantDb": {
      "unit": "units:db"
    },
    "sensitivityDb": {
      "unit": "units:db"
    },
    "recoveryMs": {
      "unit": "units:ms"
    },
    "bandHz": {
      "props": [
        "lv2:integer",
        "pprops:logarithmic"
      ],
      "unit": "units:hz"
    },
    "bandWidthOct": {
      "unit": "units:oct"
    },
    "popDb": {
      "unit": "units:db"
    },
    "popSensitivityDb": {
      "unit": "units:db"
    },
    "popRecoveryMs": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:ms"
    },
    "popHz": {
      "props": [
        "lv2:integer",
        "pprops:logarithmic"
      ],
      "unit": "units:hz"
    },
    "enabled": {
      "props": [
        "lv2:toggled"
      ]
    },
    "latency": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:frame"
    }
  }
}
