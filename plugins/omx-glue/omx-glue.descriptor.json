{
  "$schema": "https://github.com/FreeMixer/omx-contract/raw/v3/schema/omx-contract.schema.json",
  "requires": {
    "omx-contract-schema": ">= 3.7.0"
  },
  "origin": "authored",
  "plugin": {
    "id": "org.openmixer.glue",
    "format": "clap",
    "uri": "urn:openmixer:glue",
    "name": "omx glue",
    "vendor": "openmixer",
    "version": "0.18.0",
    "doc": "A bus compressor with the detents of a classic console: stepped ratio, attack and release, a key filter and a dry mix.",
    "features": [
      "audio-effect"
    ]
  },
  "controls": [
    {
      "id": 0,
      "symbol": "thresholdDb",
      "name": "Threshold",
      "kind": "travel",
      "travel": {
        "min": -40,
        "max": 0,
        "step": 0,
        "unit": "dB",
        "default": -10,
        "scale": "linear"
      },
      "group": [
        "Glue"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/glue.json#GLUE_THRESHOLD_DB_RANGE",
          "at": "omx-dsp@0.29.0"
        }
      }
    },
    {
      "id": 1,
      "symbol": "ratio",
      "name": "Ratio",
      "kind": "choice",
      "ids": [
        "0",
        "1",
        "2"
      ],
      "labels": [
        "2:1",
        "4:1",
        "10:1"
      ],
      "values": [
        0,
        1,
        2
      ],
      "default": "0",
      "group": [
        "Glue"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/glue.json#GLUE_RATIOS",
          "at": "omx-dsp@0.29.0"
        }
      }
    },
    {
      "id": 2,
      "symbol": "attack",
      "name": "Attack",
      "kind": "choice",
      "ids": [
        "0",
        "1",
        "2",
        "3",
        "4",
        "5"
      ],
      "labels": [
        "0.1 ms",
        "0.3 ms",
        "1 ms",
        "3 ms",
        "10 ms",
        "30 ms"
      ],
      "values": [
        0,
        1,
        2,
        3,
        4,
        5
      ],
      "default": "4",
      "group": [
        "Glue"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/glue.json#GLUE_ATTACKS",
          "at": "omx-dsp@0.29.0"
        }
      }
    },
    {
      "id": 3,
      "symbol": "release",
      "name": "Release",
      "kind": "choice",
      "ids": [
        "0",
        "1",
        "2",
        "3",
        "4"
      ],
      "labels": [
        "0.1 s",
        "0.3 s",
        "0.6 s",
        "1.2 s",
        "Auto"
      ],
      "values": [
        0,
        1,
        2,
        3,
        4
      ],
      "default": "4",
      "group": [
        "Glue"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/glue.json#GLUE_RELEASES",
          "at": "omx-dsp@0.29.0"
        }
      }
    },
    {
      "id": 4,
      "symbol": "makeupDb",
      "name": "Makeup",
      "kind": "travel",
      "travel": {
        "min": 0,
        "max": 24,
        "step": 0,
        "unit": "dB",
        "default": 0,
        "scale": "linear"
      },
      "group": [
        "Glue"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/glue.json#GLUE_MAKEUP_DB_RANGE",
          "at": "omx-dsp@0.29.0"
        }
      }
    },
    {
      "id": 5,
      "symbol": "keyHpHz",
      "name": "Key High-pass",
      "kind": "travel",
      "travel": {
        "min": 0,
        "max": 500,
        "step": 1,
        "unit": "Hz",
        "default": 0,
        "scale": "stepped"
      },
      "group": [
        "Glue"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/glue.json#GLUE_KEY_HP_HZ_RANGE",
          "at": "omx-dsp@0.29.0"
        }
      }
    },
    {
      "id": 6,
      "symbol": "mixPct",
      "name": "Mix",
      "kind": "travel",
      "travel": {
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "default": 100,
        "scale": "stepped"
      },
      "group": [
        "Glue"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/glue.json#GLUE_MIX_PCT_RANGE",
          "at": "omx-dsp@0.29.0"
        }
      }
    },
    {
      "id": 7,
      "symbol": "detectorTopology",
      "name": "Detector Topology",
      "kind": "choice",
      "ids": [
        "0",
        "1"
      ],
      "labels": [
        "Feedforward",
        "Feedback"
      ],
      "values": [
        0,
        1
      ],
      "default": "0",
      "group": [
        "Glue"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/comp.json#DETECTOR_TOPOLOGY",
          "at": "omx-dsp@0.29.0"
        }
      }
    }
  ],
  "ports": [
    {
      "id": 0,
      "name": "in",
      "kind": "audio",
      "direction": "in",
      "role": "main",
      "channels": 2,
      "layout": "stereo"
    },
    {
      "id": 0,
      "name": "out",
      "kind": "audio",
      "direction": "out",
      "role": "main",
      "channels": 2,
      "layout": "stereo"
    }
  ],
  "needs": {
    "extensions": {
      "optional": [
        "lv2:hardRTCapable"
      ]
    }
  },
  "latency": {
    "reports": true
  },
  "extensions": {
    "clap": {
      "clap_plugin_descriptor.features": [
        "CLAP_PLUGIN_FEATURE_COMPRESSOR",
        "CLAP_PLUGIN_FEATURE_STEREO"
      ]
    },
    "lv2": {
      "rdf:type": [
        "lv2:Plugin",
        "lv2:CompressorPlugin"
      ]
    }
  },
  "source": {
    "impl": "plugins/omx-glue/omx_glue_clap.c#clap_entry"
  }
}
