{
  "$comment": "THE declaration of omx-deesser, the folder's one hand-written file. Every other file of the folder is generated from it by tools/gen.mjs. Its parameters are by reference to omx-contract's deesser kernel and bind by name to omx-dsp's instance face. Parameter order is append-only.",
  "stem": "omx-deesser",
  "kernel": "deesser",
  "kernels": [
    "deesser"
  ],
  "name": "omx deesser",
  "noun": "de-esser",
  "vendor": "openmixer",
  "url": "https://github.com/FreeMixer/omx-plugins",
  "version": "0.3.0",
  "description": "The console's de-esser: a detector on a band around the sibilance drives the compressor's gain computer, and the reduction lands on that band alone or on the whole signal.",
  "clap": {
    "id": "org.openmixer.deesser",
    "features": [
      "audio-effect",
      "de-esser",
      "stereo"
    ]
  },
  "lv2": {
    "uri": "urn:openmixer:deesser",
    "class": "lv2:DynamicsPlugin"
  },
  "binding": "instance",
  "params": [
    {
      "symbol": "deessFreq",
      "name": "Freq",
      "ref": "DEESS_FREQ_RANGE"
    },
    {
      "symbol": "deessWidth",
      "name": "Width",
      "ref": "DEESS_WIDTH_RANGE"
    },
    {
      "symbol": "deessThreshold",
      "name": "Threshold",
      "ref": "DEESS_THRESHOLD_RANGE"
    },
    {
      "symbol": "deessRatio",
      "name": "Ratio",
      "ref": "DEESS_RATIO_RANGE"
    },
    {
      "symbol": "deessRange",
      "name": "Range",
      "ref": "DEESS_RANGE_RANGE"
    },
    {
      "symbol": "deessAttack",
      "name": "Attack",
      "ref": "DEESS_ATTACK_RANGE"
    },
    {
      "symbol": "deessRelease",
      "name": "Release",
      "ref": "DEESS_RELEASE_RANGE"
    },
    {
      "symbol": "deessMode",
      "name": "Mode",
      "ref": "DEESS_MODES",
      "values": [
        "Split",
        "Wideband"
      ]
    }
  ],
  "portHints": {
    "deessFreq": {
      "props": [
        "lv2:integer",
        "pprops:logarithmic"
      ],
      "unit": "units:hz"
    },
    "deessWidth": {
      "unit": "units:oct"
    },
    "deessThreshold": {
      "unit": "units:db"
    },
    "deessRange": {
      "unit": "units:db"
    },
    "deessAttack": {
      "unit": "units:ms"
    },
    "deessRelease": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:ms"
    },
    "deessMode": {
      "props": [
        "lv2:enumeration",
        "lv2:integer"
      ],
      "points": [
        "0 Split",
        "1 Wideband"
      ]
    },
    "enabled": {
      "props": [
        "lv2:toggled"
      ]
    },
    "latency": {
      "props": [
        "lv2:integer",
        "lv2:reportsLatency"
      ],
      "unit": "units:frame"
    }
  },
  "panel": {
    "family": "deesser",
    "roles": {},
    "sections": [
      {
        "key": "deesser",
        "label": "Deesser",
        "controls": [
          "deessFreq",
          "deessWidth",
          "deessThreshold",
          "deessRatio",
          "deessRange",
          "deessAttack",
          "deessRelease",
          "deessMode"
        ]
      }
    ]
  },
  "console": {
    "$comment": "As FreeMixer/openmixer integration/waves-2026-10 draws its deEsser stage: DeEsserPanel.vue (mode select, then freqHz, widthOct, thresholdDb, ratio, rangeDb, attackMs, releaseMs, then a gain-reduction bar, a readout the contract does not declare yet); its band and GR are drawn over the EQ curve, not in its panel. Chip: STAGE_CHIP_PARAMS.deEsser. Its overview card has no controls.",
    "placement": {
      "strips": [
        "input",
        "fxReturn",
        "aux",
        "mix",
        "matrix",
        "main",
        "fxSend",
        "mixMinus"
      ],
      "group": "walk",
      "stage": "deEsser",
      "after": "eq",
      "fxGroup": "dynamics"
    },
    "chip": "FREQ {deessFreq} · THR {deessThreshold}",
    "panel": {
      "sections": [
        {
          "key": "deEsser",
          "label": "De-esser",
          "controls": [
            "deessMode",
            "deessFreq",
            "deessWidth",
            "deessThreshold",
            "deessRatio",
            "deessRange",
            "deessAttack",
            "deessRelease"
          ]
        }
      ]
    }
  }
}
