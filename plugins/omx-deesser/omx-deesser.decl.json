{
  "$comment": "The extras of omx-deesser's declaration: what its descriptor, omx-deesser.descriptor.json, has no word for (docs/declaration-as-descriptor.md). The two are the folder's hand-written files; tools/gen.mjs generates the rest and writes the travels the descriptor's links resolve to. Its parameters are by reference to omx-contract's deesser kernel and bind by name to omx-dsp's instance face. Control order, the descriptor's, is append-only.",
  "stem": "omx-deesser",
  "kernel": "deesser",
  "kernels": [
    "deesser"
  ],
  "noun": "de-esser",
  "url": "https://github.com/FreeMixer/omx-plugins",
  "description": "The console's de-esser: a detector on a band around the sibilance drives the compressor's gain computer, and the reduction lands on that band alone or on the whole signal.",
  "clap": {
    "features": [
      "audio-effect",
      "de-esser",
      "stereo"
    ]
  },
  "lv2": {
    "class": "lv2:DynamicsPlugin"
  },
  "binding": "instance",
  "controls": {
    "deessMode": {
      "values": [
        "Split",
        "Wideband"
      ]
    }
  },
  "portHints": {
    "deessFreq": {
      "props": [
        "lv2:integer",
        "pprops:logarithmic"
      ],
      "unit": "units:hz"
    },
    "deessWidth": {
      "unit": "units:oct"
    },
    "deessThreshold": {
      "unit": "units:db"
    },
    "deessRange": {
      "unit": "units:db"
    },
    "deessAttack": {
      "unit": "units:ms"
    },
    "deessRelease": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:ms"
    },
    "deessMode": {
      "props": [
        "lv2:enumeration",
        "lv2:integer"
      ],
      "points": [
        "0 Split",
        "1 Wideband"
      ]
    },
    "enabled": {
      "props": [
        "lv2:toggled"
      ]
    },
    "latency": {
      "props": [
        "lv2:integer",
        "lv2:reportsLatency"
      ],
      "unit": "units:frame"
    }
  },
  "meters": [
    {
      "id": "deessGr",
      "kind": "gain_reduction",
      "field": "state.band.gr_min_db",
      "floor": "deessRange"
    },
    {
      "id": "deessIn",
      "kind": "level",
      "source": "input",
      "min": -60,
      "max": 6
    },
    {
      "id": "deessOut",
      "kind": "level",
      "source": "output",
      "min": -60,
      "max": 6
    }
  ],
  "panel": {
    "family": "deesser",
    "roles": {
      "frequency": "deessFreq",
      "threshold": "deessThreshold",
      "range": "deessRange",
      "width": "deessWidth",
      "ratio": "deessRatio",
      "attack": "deessAttack",
      "release": "deessRelease",
      "mode": "deessMode"
    },
    "sections": [
      {
        "key": "deEsser",
        "label": "De-esser",
        "controls": [
          "deessMode",
          "deessFreq",
          "deessWidth",
          "deessThreshold",
          "deessRatio",
          "deessRange",
          "deessAttack",
          "deessRelease"
        ]
      }
    ]
  },
  "console": {
    "$comment": "The OpenMixer console draws its deEsser stage: the de-esser panel (mode select, then freqHz, widthOct, thresholdDb, ratio, rangeDb, attackMs, releaseMs, then a gain-reduction bar, a readout the contract does not declare yet); its band and GR are drawn over the EQ curve, not in its panel. Its chip shows the de-esser's main settings. Its overview card has no controls.",
    "placement": {
      "strips": [
        "input",
        "fxReturn",
        "aux",
        "mix",
        "matrix",
        "main",
        "fxSend",
        "mixMinus"
      ],
      "group": "walk",
      "stage": "deEsser",
      "after": "eq",
      "fxGroup": "dynamics"
    },
    "chip": "FREQ {deessFreq} · THR {deessThreshold}"
  }
}
