      "id": 6,
      "symbol": "deessRelease",
      "name": "Release",
      "kind": "travel",
      "travel": {
        "min": 5,
        "max": 500,
        "step": 1,
        "unit": "ms",
        "default": 60,
        "scale": "stepped"
