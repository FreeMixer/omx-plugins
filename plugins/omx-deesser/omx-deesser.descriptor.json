      "id": 0,
      "symbol": "deessFreq",
      "name": "Freq",
      "kind": "travel",
      "travel": {
        "min": 2000,
        "max": 16000,
        "step": 1,
        "unit": "Hz",
        "default": 7000,
        "scale": "stepped"
      },
      "group": [
        "De-esser"
      ],
      "meaning": "frequency",
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/deesser.json#DEESS_FREQ_RANGE",
          "at": "omx-dsp@0.26.0"
        }
      }
    },
    {
      "id": 1,
      "symbol": "deessWidth",
      "name": "Width",
      "kind": "travel",
      "travel": {
        "min": 0.25,
        "max": 4,
        "step": 0,
        "unit": "oct",
        "default": 1,
        "scale": "linear"
      },
      "group": [
        "De-esser"
      ],
      "meaning": "width",
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/deesser.json#DEESS_WIDTH_RANGE",
