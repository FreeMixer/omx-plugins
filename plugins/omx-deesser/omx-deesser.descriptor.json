    {
      "id": 4,
      "symbol": "deessRange",
      "name": "Range",
      "kind": "travel",
      "travel": {
        "min": -24,
        "max": 0,
        "step": 0,
        "unit": "dB",
        "default": -12,
        "scale": "linear"
      },
      "group": [
        "De-esser"
      ],
      "meaning": "range",
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/deesser.json#DEESS_RANGE_RANGE",
