    {
      "id": 2,
      "symbol": "deessThreshold",
      "name": "Threshold",
      "kind": "travel",
      "travel": {
        "min": -60,
        "max": 0,
        "step": 0,
        "unit": "dB",
        "default": -30,
        "scale": "linear"
      },
      "group": [
        "De-esser"
      ],
      "meaning": "threshold",
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/deesser.json#DEESS_THRESHOLD_RANGE",
          "at": "omx-dsp@0.26.0"
        }
      }
    },
    {
      "id": 3,
      "symbol": "deessRatio",
      "name": "Ratio",
      "kind": "travel",
      "travel": {
        "min": 1,
        "max": 20,
        "step": 0,
        "unit": "ratio",
        "default": 4,
        "scale": "linear"
