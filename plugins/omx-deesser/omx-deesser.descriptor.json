{
  "$schema": "https://github.com/FreeMixer/omx-contract/raw/v3/schema/omx-contract.schema.json",
  "requires": {
    "omx-contract-schema": ">= 3.0.0"
  },
  "origin": "authored",
  "plugin": {
    "id": "org.openmixer.deesser",
    "format": "clap",
    "uri": "urn:openmixer:deesser",
    "name": "omx deesser",
    "vendor": "openmixer",
    "version": "0.15.1",
    "doc": "The console's de-esser: a detector on a band around the sibilance drives the compressor's gain computer, and the reduction lands on that band alone or on the whole signal.",
    "features": [
      "audio-effect"
    ]
  },
  "controls": [
