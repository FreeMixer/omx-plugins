{
  "$comment": "THE declaration of omx-reverb, the folder's one hand-written file. Every other file of the folder is generated from it by tools/gen.mjs. Its parameters are by reference to omx-contract's reverb kernel and bind by name to omx-dsp's instance face. Parameter order is append-only.",
  "stem": "omx-reverb",
  "kernel": "reverb",
  "kernels": [
    "reverb"
  ],
  "name": "omx reverb",
  "vendor": "openmixer",
  "url": "https://github.com/FreeMixer/omx-plugins",
  "version": "0.2.0",
  "description": "The console's reverb: room, plate, hall, reverse and gated algorithms with pre-delay, size, damping, width and low and high cuts, mixed with the dry signal.",
  "clap": {
    "id": "org.openmixer.reverb",
    "features": [
      "audio-effect",
      "reverb",
      "stereo"
    ]
  },
  "lv2": {
    "uri": "urn:openmixer:reverb",
    "class": "lv2:ReverbPlugin"
  },
  "binding": "instance",
  "params": [
    {
      "symbol": "plateModDepth",
      "name": "Plate Mod Depth",
      "ref": "REVERB_PLATE_MOD_DEPTH_RANGE"
    },
    {
      "symbol": "mix",
      "name": "Mix",
      "ref": "REVERB_MIX_RANGE"
    },
    {
      "symbol": "size",
      "name": "Size",
      "ref": "REVERB_SIZE_RANGE"
    },
    {
      "symbol": "damping",
      "name": "Damping",
      "ref": "REVERB_DAMPING_RANGE"
    },
    {
      "symbol": "width",
      "name": "Width",
      "ref": "REVERB_WIDTH_RANGE"
    },
    {
      "symbol": "predelay",
      "name": "Predelay",
      "ref": "REVERB_PREDELAY_RANGE"
    },
    {
      "symbol": "lowcut",
      "name": "Lowcut",
      "ref": "REVERB_LOWCUT_RANGE"
    },
    {
      "symbol": "highcut",
      "name": "Highcut",
      "ref": "REVERB_HIGHCUT_RANGE"
    },
    {
      "symbol": "reverse",
      "name": "Reverse",
      "ref": "REVERB_REVERSE_RANGE"
    },
    {
      "symbol": "hold",
      "name": "Hold",
      "ref": "REVERB_HOLD_RANGE"
    },
    {
      "symbol": "release",
      "name": "Release",
      "ref": "REVERB_RELEASE_RANGE"
    },
    {
      "symbol": "gateThreshold",
      "name": "Gate Threshold",
      "ref": "REVERB_GATE_THRESHOLD_RANGE"
    },
    {
      "symbol": "algorithm",
      "name": "Algorithm",
      "ref": "REVERB_ALGORITHMS",
      "values": [
        "Room",
        "Plate",
        "Hall",
        "Reverse",
        "Gated"
      ]
    }
  ],
  "portHints": {
    "plateModDepth": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:pc"
    },
    "predelay": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:ms"
    },
    "lowcut": {
      "props": [
        "lv2:integer",
        "pprops:logarithmic"
      ],
      "unit": "units:hz"
    },
    "highcut": {
      "props": [
        "lv2:integer",
        "pprops:logarithmic"
      ],
      "unit": "units:hz"
    },
    "reverse": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:ms"
    },
    "hold": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:ms"
    },
    "release": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:ms"
    },
    "gateThreshold": {
      "props": [
        "lv2:integer"
      ]
    },
    "algorithm": {
      "props": [
        "lv2:enumeration",
        "lv2:integer"
      ],
      "points": [
        "0 Room",
        "1 Plate",
        "2 Hall",
        "3 Reverse",
        "4 Gated"
      ]
    },
    "enabled": {
      "props": [
        "lv2:toggled"
      ]
    },
    "latency": {
      "props": [
        "lv2:integer",
        "lv2:reportsLatency"
      ],
      "unit": "units:frame"
    }
  },
  "panel": {
    "family": "reverb",
    "roles": {},
    "sections": [
      {
        "key": "reverb",
        "label": "Reverb",
        "controls": [
          "plateModDepth",
          "mix",
          "size",
          "damping",
          "width",
          "predelay",
          "lowcut",
          "highcut",
          "reverse",
          "hold",
          "release",
          "gateThreshold",
          "algorithm"
        ]
      }
    ]
  },
  "console": {
    "$comment": "As FreeMixer/openmixer integration/waves-2026-10 draws its reverb stage: FxPanel's StageTimeCurve (decay) over ReverbPanel.vue (preset and algorithm selects, then size, damping, predelayMs, width, mix, lowcut, highcut, then the reverse, gated or plate row of the chosen algorithm). Chip: FxSummaryValue of STAGE_KEY_FIELD.reverb (size). Card: useStripOverview's reverb controls.",
    "placement": {
      "strips": [
        "input",
        "fxReturn",
        "aux",
        "mix",
        "matrix",
        "main",
        "fxSend",
        "mixMinus"
      ],
      "group": "walk",
      "stage": "reverb",
      "after": "delay",
      "fxGroup": "reverb"
    },
    "card": {
      "show": [
        "size",
        "damping",
        "mix"
      ]
    },
    "chip": "{size}",
    "panel": {
      "sections": [
        {
          "key": "reverb",
          "label": "Reverb",
          "controls": [
            "algorithm",
            "size",
            "damping",
            "predelay",
            "width",
            "mix",
            "lowcut",
            "highcut"
          ],
          "graph": "decay-envelope"
        },
        {
          "key": "reverse",
          "label": "Reverse",
          "controls": [
            "reverse"
          ]
        },
        {
          "key": "gated",
          "label": "Gated",
          "controls": [
            "hold",
            "release",
            "gateThreshold"
          ]
        },
        {
          "key": "plate",
          "label": "Plate",
          "controls": [
            "plateModDepth"
          ]
        }
      ]
    }
  }
}
