{
  "$comment": "The extras of omx-reverb's declaration: what its descriptor, omx-reverb.descriptor.json, has no word for (docs/declaration-as-descriptor.md). The two are the folder's hand-written files; tools/gen.mjs generates the rest and writes the travels the descriptor's links resolve to. Its parameters are by reference to omx-contract's reverb kernel and bind by name to omx-dsp's instance face. Control order, the descriptor's, is append-only.",
  "stem": "omx-reverb",
  "kernel": "reverb",
  "kernels": [
    "reverb"
  ],
  "url": "https://github.com/FreeMixer/omx-plugins",
  "binding": "instance",
  "controls": {
    "algorithm": {
      "values": [
        "Room",
        "Plate",
        "Hall",
        "Reverse",
        "Gated"
      ]
    }
  },
  "fixed": {
    "earlyDb": "default",
    "tailDb": "default",
    "earlySizePct": "default",
    "duckDb": "default",
    "duckThresholdDb": "default",
    "duckReleaseMs": "default",
    "wetDeess": "default",
    "deessFreqHz": "default",
    "deessThresholdDb": "default"
  },
  "portHints": {
    "plateModDepth": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:pc"
    },
    "predelay": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:ms"
    },
    "lowcut": {
      "props": [
        "lv2:integer",
        "pprops:logarithmic"
      ],
      "unit": "units:hz"
    },
    "highcut": {
      "props": [
        "lv2:integer",
        "pprops:logarithmic"
      ],
      "unit": "units:hz"
    },
    "reverse": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:ms"
    },
    "hold": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:ms"
    },
    "release": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:ms"
    },
    "gateThreshold": {
      "props": [
        "lv2:integer"
      ]
    },
    "algorithm": {
      "props": [
        "lv2:enumeration",
        "lv2:integer"
      ],
      "points": [
        "0 Room",
        "1 Plate",
        "2 Hall",
        "3 Reverse",
        "4 Gated"
      ]
    },
    "enabled": {
      "props": [
        "lv2:toggled"
      ]
    },
    "latency": {
      "props": [
        "lv2:integer",
        "lv2:reportsLatency"
      ],
      "unit": "units:frame"
    }
  },
  "resourceHints": {
    "threads-spawned": 0,
    "streams-from-disk": false,
    "opens-sockets": false
  },
  "panel": {
    "family": "reverb",
    "roles": {
      "size": "size",
      "algorithm": "algorithm",
      "predelay": "predelay",
      "damping": "damping",
      "width": "width",
      "low_cut": "lowcut",
      "high_cut": "highcut",
      "mix": "mix"
    },
    "sections": [
      {
        "key": "reverb",
        "label": "Reverb",
        "controls": [
          "algorithm",
          "size",
          "damping",
          "predelay",
          "width",
          "mix",
          "lowcut",
          "highcut"
        ],
        "graph": "decay-envelope"
      },
      {
        "key": "reverse",
        "label": "Reverse",
        "controls": [
          "reverse"
        ]
      },
      {
        "key": "gated",
        "label": "Gated",
        "controls": [
          "hold",
          "release",
          "gateThreshold"
        ]
      },
      {
        "key": "plate",
        "label": "Plate",
        "controls": [
          "plateModDepth"
        ]
      }
    ]
  },
  "console": {
    "$comment": "The OpenMixer console draws its reverb stage: the decay drawn over time, above the reverb panel (preset and algorithm selects, then size, damping, predelayMs, width, mix, lowcut, highcut, then the reverse, gated or plate row of the chosen algorithm). Its chip shows size. Its overview card carries the reverb's controls.",
    "placement": {
      "strips": [
        "input",
        "fxReturn",
        "aux",
        "mix",
        "matrix",
        "main",
        "fxSend",
        "mixMinus"
      ],
      "group": "walk",
      "stage": "reverb",
      "after": "delay",
      "fxGroup": "reverb"
    },
    "card": {
      "show": [
        "size",
        "damping",
        "mix"
      ]
    },
    "chip": "{size}"
  }
}
