{
  "$comment": "THE declaration of omx-limiter, the folder's one hand-written file. Every other file of the folder is generated from it by tools/gen.mjs. Its parameters are by reference to omx-contract's limiter kernel and bind by name to omx-dsp's instance face. Parameter order is append-only.",
  "stem": "omx-limiter",
  "kernel": "limiter",
  "kernels": [
    "limiter"
  ],
  "name": "omx limiter",
  "vendor": "openmixer",
  "url": "https://github.com/FreeMixer/omx-plugins",
  "version": "0.2.0",
  "description": "The precision limiter: a look-ahead, true-peak, stereo-linked brickwall.",
  "clap": {
    "id": "org.openmixer.limiter",
    "features": [
      "audio-effect",
      "limiter",
      "stereo"
    ]
  },
  "lv2": {
    "uri": "urn:openmixer:limiter",
    "class": "lv2:LimiterPlugin"
  },
  "binding": "instance",
  "params": [
    {
      "symbol": "ceilingDb",
      "name": "Ceiling",
      "ref": "LIMITER_LIMITS",
      "field": "ceilingDb"
    },
    {
      "symbol": "lookaheadMs",
      "name": "Lookahead",
      "ref": "LIMITER_LIMITS",
      "field": "lookaheadMs"
    },
    {
      "symbol": "releaseMs",
      "name": "Release",
      "ref": "LIMITER_LIMITS",
      "field": "releaseMs"
    }
  ],
  "portHints": {
    "lookaheadMs": {
      "unit": "units:ms"
    },
    "releaseMs": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:ms"
    },
    "enabled": {
      "props": [
        "lv2:toggled"
      ]
    },
    "latency": {
      "props": [
        "lv2:integer",
        "lv2:reportsLatency"
      ],
      "unit": "units:frame"
    }
  },
  "panel": {
    "family": "limiter",
    "roles": {},
    "sections": [
      {
        "key": "limiter",
        "label": "Limiter",
        "controls": [
          "ceilingDb",
          "lookaheadMs",
          "releaseMs"
        ]
      }
    ]
  }
}
