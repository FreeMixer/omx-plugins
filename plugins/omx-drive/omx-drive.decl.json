  "version": "0.2.0",
  "description": "the native DRIVE stage: one waveshaper, run inside the console's ONE oversampler.",
  "summary": "The console's drive: one waveshaper run inside the console's oversampler, with drive, character, band, wet/dry mix and trim. Stereo, real-time safe, 44.1 to 192 kHz.",
  "clap": {
    "id": "org.openmixer.drive",
    "features": [
