{
  "$comment": "THE declaration of omx-drive, the folder's one hand-written file. Every other file of the folder is generated from it by tools/gen.mjs. Its parameters are by reference to omx-contract's drive kernel and bind by name to omx-dsp's instance face. Parameter order is append-only.",
  "stem": "omx-drive",
  "kernel": "drive",
  "kernels": [
    "drive"
  ],
  "name": "omx drive",
  "vendor": "openmixer",
  "url": "https://github.com/FreeMixer/omx-plugins",
  "version": "0.2.0",
  "description": "The console's drive: one waveshaper (soft, tape, tube or exciter) run inside the console's oversampler, on the full band, the lows, the highs or a tilt, with a wet/dry mix and a trim.",
  "summary": "The console's drive: one waveshaper (soft, tape, tube or exciter) run inside the console's 4x oversampler, on the full band, the lows, the highs or a tilt, with drive, character, wet/dry mix and trim. Stereo, real-time safe, 44.1 to 192 kHz.",
  "clap": {
    "id": "org.openmixer.drive",
    "features": [
      "audio-effect",
      "distortion",
      "stereo"
    ]
  },
  "lv2": {
    "uri": "urn:openmixer:drive",
    "class": "lv2:DistortionPlugin"
  },
  "binding": "instance",
  "params": [
    {
      "symbol": "amount",
      "name": "Drive",
      "ref": "DRIVE_AMOUNT_RANGE"
    },
    {
      "symbol": "character",
      "name": "Character",
      "ref": "DRIVE_CHARACTER_RANGE"
    },
    {
      "symbol": "bandFreq",
      "name": "Band Frequency",
      "ref": "DRIVE_BAND_FREQ_RANGE"
    },
    {
      "symbol": "mix",
      "name": "Mix",
      "ref": "DRIVE_MIX_RANGE"
    },
    {
      "symbol": "trim",
      "name": "Trim",
      "ref": "DRIVE_TRIM_RANGE"
    },
    {
      "symbol": "curve",
      "name": "Curve",
      "ref": "DRIVE_CURVES",
      "values": [
        "Soft",
        "Tape",
        "Tube",
        "Exciter"
      ]
    },
    {
      "symbol": "band",
      "name": "Band",
      "ref": "DRIVE_BANDS",
      "values": [
        "Full",
        "Low",
        "High",
        "Tilt"
      ]
    },
    {
      "symbol": "autoGain",
      "name": "Auto Gain",
      "ref": "DRIVE_AUTO_GAINS"
    },
    {
      "symbol": "stereoLink",
      "name": "Stereo Link",
      "ref": "DRIVE_STEREO_LINKS"
    },
    {
      "symbol": "hfRolloff",
      "name": "HF Roll-off",
      "ref": "DRIVE_HF_ROLLOFFS"
    }
  ],
  "portHints": {
    "amount": {
      "unit": "units:db"
    },
    "bandFreq": {
      "props": [
        "lv2:integer",
        "pprops:logarithmic"
      ],
      "unit": "units:hz"
    },
    "mix": {
      "unit": "units:pc"
    },
    "trim": {
      "unit": "units:db"
    },
    "curve": {
      "props": [
        "lv2:enumeration",
        "lv2:integer"
      ],
      "points": [
        "0 Soft",
        "1 Tape",
        "2 Tube",
        "3 Exciter"
      ]
    },
    "band": {
      "props": [
        "lv2:enumeration",
        "lv2:integer"
      ],
      "points": [
        "0 Full",
        "1 Low",
        "2 High",
        "3 Tilt"
      ]
    },
    "autoGain": {
      "props": [
        "lv2:toggled"
      ]
    },
    "stereoLink": {
      "props": [
        "lv2:toggled"
      ]
    },
    "hfRolloff": {
      "props": [
        "lv2:enumeration",
        "lv2:integer"
      ],
      "points": [
        "0 0",
        "12000 12000",
        "16000 16000"
      ]
    },
    "enabled": {
      "props": [
        "lv2:toggled"
      ]
    },
    "latency": {
      "props": [
        "lv2:integer",
        "lv2:reportsLatency"
      ],
      "unit": "units:frame"
    }
  },
  "panel": {
    "family": "drive",
    "roles": {
      "drive": "amount",
      "character": "character",
      "band": "bandFreq",
      "mix": "mix",
      "trim": "trim",
      "curve": "curve",
      "bandMode": "band",
      "autoGain": "autoGain",
      "stereoLink": "stereoLink",
      "hfRolloff": "hfRolloff"
    },
    "sections": [
      {
        "key": "drive",
        "label": "Drive",
        "controls": [
          "amount",
          "character",
          "bandFreq",
          "mix",
          "trim",
          "curve",
          "band",
          "autoGain",
          "stereoLink",
          "hfRolloff"
        ]
      }
    ]
  }
}
