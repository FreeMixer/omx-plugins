    "class": "lv2:Plugin"
  },
  "params": [
    { "symbol": "driveDb", "name": "Drive", "ref": "DRIVE_AMOUNT_RANGE" },
    { "symbol": "character", "name": "Character", "ref": "DRIVE_CHARACTER_RANGE" },
    { "symbol": "bandHz", "name": "Band", "ref": "DRIVE_BAND_FREQ_RANGE" },
    { "symbol": "mix", "name": "Mix", "ref": "DRIVE_MIX_RANGE" },
    { "symbol": "trimDb", "name": "Trim", "ref": "DRIVE_TRIM_RANGE" }
  ],
  "panel": {
    "family": "drive",
    "roles": {
      "drive": "driveDb",
      "character": "character",
      "band": "bandHz",
      "mix": "mix",
      "trim": "trimDb"
    },
    "sections": [
      {
        "key": "drive",
        "label": "Drive",
        "controls": [
          "driveDb",
          "character",
          "bandHz",
          "mix",
          "trimDb"
        ]
      }
    ]
  },
  "manual": [
    "| Parameter | Range | Default |",
    "|---|---|---|",
    "| Drive | 0 to 36 dB | 0 dB |",
    "| Character | -1 to 1 | 0 |",
    "| Band | 20 to 20000 Hz | 2000 Hz |",
    "| Mix | 0 to 100 % | 100 % |",
    "| Trim | -24 to +12 dB | 0 dB |",
