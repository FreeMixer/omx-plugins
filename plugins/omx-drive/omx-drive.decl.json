{
  "$comment": "The extras of omx-drive's declaration: what its descriptor, omx-drive.descriptor.json, has no word for (docs/declaration-as-descriptor.md). The two are the folder's hand-written files; tools/gen.mjs generates the rest and writes the travels the descriptor's links resolve to. Its parameters are by reference to omx-contract's drive kernel and bind by name to omx-dsp's instance face. Control order, the descriptor's, is append-only.",
  "stem": "omx-drive",
  "kernel": "drive",
  "kernels": [
    "drive"
  ],
  "url": "https://github.com/FreeMixer/omx-plugins",
  "description": "The console's drive: one waveshaper (soft, tape, tube or exciter) run inside the console's oversampler, on the full band, the lows, the highs or a tilt, with a wet/dry mix and a trim.",
  "summary": "The console's drive: one waveshaper (soft, tape, tube or exciter) run inside the console's 4x oversampler, on the full band, the lows, the highs or a tilt, with drive, character, wet/dry mix and trim. Stereo, real-time safe, 44.1 to 192 kHz.",
  "clap": {
    "features": [
      "audio-effect",
      "distortion",
      "stereo"
    ]
  },
  "lv2": {
    "class": "lv2:DistortionPlugin"
  },
  "binding": "instance",
  "controls": {
    "curve": {
      "values": [
        "Soft",
        "Tape",
        "Tube",
        "Exciter"
      ]
    },
    "band": {
      "values": [
        "Full",
        "Low",
        "High",
        "Tilt"
      ]
    }
  },
  "portHints": {
    "amount": {
      "unit": "units:db"
    },
    "bandFreq": {
      "props": [
        "lv2:integer",
        "pprops:logarithmic"
      ],
      "unit": "units:hz"
    },
    "mix": {
      "unit": "units:pc"
    },
    "trim": {
      "unit": "units:db"
    },
    "curve": {
      "props": [
        "lv2:enumeration",
        "lv2:integer"
      ],
      "points": [
        "0 Soft",
        "1 Tape",
        "2 Tube",
        "3 Exciter"
      ]
    },
    "band": {
      "props": [
        "lv2:enumeration",
        "lv2:integer"
      ],
      "points": [
        "0 Full",
        "1 Low",
        "2 High",
        "3 Tilt"
      ]
    },
    "autoGain": {
      "props": [
        "lv2:toggled"
      ]
    },
    "stereoLink": {
      "props": [
        "lv2:toggled"
      ]
    },
    "hfRolloff": {
      "props": [
        "lv2:enumeration",
        "lv2:integer"
      ],
      "points": [
        "0 Off",
        "1 12 kHz",
        "2 16 kHz"
      ]
    },
    "oversample": {
      "props": [
        "lv2:enumeration",
        "lv2:integer"
      ],
      "points": [
        "1 1",
        "2 2",
        "4 4"
      ]
    },
    "enabled": {
      "props": [
        "lv2:toggled"
      ]
    },
    "latency": {
      "props": [
        "lv2:integer",
        "lv2:reportsLatency"
      ],
      "unit": "units:frame"
    }
  },
  "panel": {
    "family": "drive",
    "roles": {
      "drive": "amount",
      "tone": "character",
      "model": "curve",
      "mix": "mix",
      "output": "trim"
    },
    "sections": [
      {
        "key": "drive",
        "label": "Drive",
        "controls": [
          "curve",
          "band",
          "hfRolloff",
          "oversample",
          "amount",
          "character",
          "bandFreq",
          "mix",
          "trim",
          "autoGain",
          "stereoLink"
        ],
        "graph": "transfer-curve"
      }
    ]
  },
  "console": {
    "$comment": "The OpenMixer console draws its drive stage: the transfer curve above the drive panel (curve, band, hfRolloff and oversample selects, then driveDb, character, bandHz, mix, trimDb, then the autoGain and stereoLink switches and a latency readout). Its chip shows driveDb. Its overview card carries the drive's controls.",
    "placement": {
      "strips": [
        "input",
        "fxReturn",
        "aux",
        "mix",
        "matrix",
        "main",
        "fxSend",
        "mixMinus"
      ],
      "group": "walk",
      "stage": "drive",
      "after": "dynamics",
      "fxGroup": "character"
    },
    "card": {
      "show": [
        "amount",
        "character",
        "mix"
      ]
    },
    "chip": "{amount}"
  }
}
