{
  "$comment": "THE declaration of omx-transient, the folder's one hand-written file. Every other file of the folder is generated from it by tools/gen.mjs. Its parameters are by reference to omx-contract's transient kernel and bind by name to omx-dsp's instance face. Parameter order is append-only.",
  "stem": "omx-transient",
  "kernel": "transient",
  "kernels": [
    "transient"
  ],
  "name": "omx transient",
  "vendor": "openmixer",
  "url": "https://github.com/FreeMixer/omx-plugins",
  "version": "0.3.0",
  "description": "The console's transient designer: more or less attack and sustain, from two envelope contrasts, with no threshold to set.",
  "clap": {
    "id": "org.openmixer.transient",
    "features": [
      "audio-effect",
      "transient-shaper",
      "stereo"
    ]
  },
  "lv2": {
    "uri": "urn:openmixer:transient",
    "class": "lv2:DynamicsPlugin"
  },
  "binding": "instance",
  "params": [
    {
      "symbol": "attackDb",
      "name": "Attack",
      "ref": "TRANSIENT_LIMITS",
      "field": "attackDb"
    },
    {
      "symbol": "sustainDb",
      "name": "Sustain",
      "ref": "TRANSIENT_LIMITS",
      "field": "sustainDb"
    },
    {
      "symbol": "attackTimeMs",
      "name": "Attack Time",
      "ref": "TRANSIENT_LIMITS",
      "field": "attackTimeMs"
    },
    {
      "symbol": "sustainTimeMs",
      "name": "Sustain Time",
      "ref": "TRANSIENT_LIMITS",
      "field": "sustainTimeMs"
    },
    {
      "symbol": "outputDb",
      "name": "Output",
      "ref": "TRANSIENT_LIMITS",
      "field": "outputDb"
    }
  ],
  "portHints": {
    "attackDb": {
      "unit": "units:db"
    },
    "sustainDb": {
      "unit": "units:db"
    },
    "attackTimeMs": {
      "unit": "units:ms"
    },
    "sustainTimeMs": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:ms"
    },
    "outputDb": {
      "unit": "units:db"
    },
    "enabled": {
      "props": [
        "lv2:toggled"
      ]
    },
    "latency": {
      "props": [
        "lv2:integer",
        "lv2:reportsLatency"
      ],
      "unit": "units:frame"
    }
  },
  "panel": {
    "family": "transient",
    "roles": {},
    "sections": [
      {
        "key": "transient",
        "label": "Transient",
        "controls": [
          "attackDb",
          "sustainDb",
          "attackTimeMs",
          "sustainTimeMs",
          "outputDb"
        ]
      }
    ]
  },
  "console": {
    "$comment": "FreeMixer/openmixer integration/waves-2026-10 has no transient stage. Racked as a plugin (the insert rack's kinds, channel-contract.ts INSERT_RACK_KINDS) it is drawn by the generic plugin editor.",
    "placement": {
      "strips": [
        "input",
        "fxReturn",
        "main",
        "aux",
        "mix",
        "matrix"
      ],
      "group": "plugins"
    }
  }
}
