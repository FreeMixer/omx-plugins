{
  "$schema": "https://github.com/FreeMixer/omx-contract/raw/v3/schema/omx-contract.schema.json",
  "requires": {
    "omx-contract-schema": ">= 3.0.0"
  },
  "origin": "authored",
  "plugin": {
    "id": "org.openmixer.transient",
    "format": "clap",
    "uri": "urn:openmixer:transient",
    "name": "omx transient",
    "vendor": "openmixer",
    "version": "0.12.0",
    "doc": "The console's transient designer: more or less attack and sustain, from two envelope contrasts, with no threshold to set.",
    "features": [
      "audio-effect"
    ]
  },
  "controls": [
    {
      "id": 0,
      "symbol": "attackDb",
      "name": "Attack",
      "kind": "travel",
      "travel": {
        "min": -24,
        "max": 24,
        "step": 0,
        "unit": "dB",
        "default": 0,
        "scale": "linear"
      },
      "group": [
        "Transient"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/transient.json#TRANSIENT_LIMITS.attackDb",
          "at": "omx-dsp@0.24.0"
        }
      }
    },
    {
      "id": 1,
      "symbol": "sustainDb",
      "name": "Sustain",
      "kind": "travel",
      "travel": {
        "min": -24,
        "max": 24,
        "step": 0,
        "unit": "dB",
        "default": 0,
        "scale": "linear"
      },
      "group": [
        "Transient"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/transient.json#TRANSIENT_LIMITS.sustainDb",
          "at": "omx-dsp@0.24.0"
        }
      }
    },
    {
      "id": 2,
      "symbol": "attackTimeMs",
      "name": "Attack Time",
      "kind": "travel",
      "travel": {
        "min": 2,
        "max": 50,
        "step": 0,
        "unit": "ms",
        "default": 10,
        "scale": "linear"
      },
      "group": [
        "Transient"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/transient.json#TRANSIENT_LIMITS.attackTimeMs",
          "at": "omx-dsp@0.24.0"
        }
      }
    },
    {
      "id": 3,
      "symbol": "sustainTimeMs",
      "name": "Sustain Time",
      "kind": "travel",
      "travel": {
        "min": 50,
        "max": 2000,
        "step": 1,
        "unit": "ms",
        "default": 250,
        "scale": "stepped"
      },
      "group": [
        "Transient"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/transient.json#TRANSIENT_LIMITS.sustainTimeMs",
          "at": "omx-dsp@0.24.0"
        }
      }
    },
    {
      "id": 4,
      "symbol": "outputDb",
      "name": "Output",
      "kind": "travel",
      "travel": {
        "min": -24,
        "max": 12,
        "step": 0,
        "unit": "dB",
        "default": 0,
        "scale": "linear"
      },
      "group": [
        "Transient"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/transient.json#TRANSIENT_LIMITS.outputDb",
          "at": "omx-dsp@0.24.0"
        }
      }
    }
  ],
  "ports": [
    {
      "id": 0,
      "name": "in",
      "kind": "audio",
      "direction": "in",
      "role": "main",
      "channels": 2,
      "layout": "stereo"
    },
    {
      "id": 0,
      "name": "out",
      "kind": "audio",
      "direction": "out",
      "role": "main",
      "channels": 2,
      "layout": "stereo"
    }
  ],
  "needs": {
    "extensions": {
      "optional": [
        "lv2:hardRTCapable"
      ]
    }
  },
  "latency": {
    "reports": true
  },
  "extensions": {
    "clap": {
      "clap_plugin_descriptor.features": [
        "CLAP_PLUGIN_FEATURE_TRANSIENT_SHAPER",
        "CLAP_PLUGIN_FEATURE_STEREO"
      ]
    },
    "lv2": {
      "rdf:type": [
        "lv2:Plugin",
        "lv2:DynamicsPlugin"
      ]
    }
  },
  "source": {
    "impl": "plugins/omx-transient/omx_transient_clap.c#clap_entry"
  }
}
