{
  "$comment": "The extras of omx-doubler's declaration: what its descriptor, omx-doubler.descriptor.json, has no word for (docs/declaration-as-descriptor.md). The two are the folder's hand-written files; tools/gen.mjs generates the rest and writes the travels the descriptor's links resolve to. Its parameters are by reference to omx-contract's doubler kernel and bind by name to omx-dsp's instance face. Control order, the descriptor's, is append-only.",
  "stem": "omx-doubler",
  "kernel": "doubler",
  "kernels": [
    "doubler"
  ],
  "noun": "doubler",
  "url": "https://github.com/FreeMixer/omx-plugins",
  "binding": "instance",
  "resourceHints": {
    "threads-spawned": 0,
    "streams-from-disk": false,
    "opens-sockets": false
  },
  "panel": {
    "family": "modulation",
    "roles": {
      "rate": "modRateHz",
      "depth": "modDepthMs",
      "voices": "voices",
      "spread": "spreadPct",
      "mix": "mixPct"
    },
    "sections": [
      {
        "key": "voices",
        "label": "Voices",
        "controls": [
          "voices",
          "delayMs",
          "detuneCents"
        ]
      },
      {
        "key": "drift",
        "label": "Drift",
        "controls": [
          "modRateHz",
          "modDepthMs"
        ]
      },
      {
        "key": "output",
        "label": "Output",
        "controls": [
          "spreadPct",
          "mixPct"
        ]
      }
    ]
  },
  "console": {
    "$comment": "The OpenMixer console has no doubler stage. Racked as a plugin in a channel insert rack, it is drawn by the generic plugin editor with this panel.",
    "placement": {
      "group": "plugins"
    }
  },
  "portHints": {
    "enabled": {
      "props": [
        "lv2:toggled"
      ]
    },
    "latency": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:frame"
    },
    "voices": {
      "props": [
        "lv2:integer"
      ]
    },
    "delayMs": {
      "unit": "units:ms"
    },
    "detuneCents": {
      "unit": "units:cent"
    },
    "modRateHz": {
      "props": [
        "pprops:logarithmic"
      ],
      "unit": "units:hz"
    },
    "modDepthMs": {
      "unit": "units:ms"
    },
    "spreadPct": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:pc"
    },
    "mixPct": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:pc"
    }
  }
}
