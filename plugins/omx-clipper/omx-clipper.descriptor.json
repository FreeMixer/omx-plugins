{
  "$schema": "https://github.com/FreeMixer/omx-contract/raw/v3/schema/omx-contract.schema.json",
  "requires": {
    "omx-contract-schema": ">= 3.1.0"
  },
  "origin": "authored",
  "plugin": {
    "id": "org.openmixer.clipper",
    "format": "clap",
    "uri": "urn:openmixer:clipper",
    "name": "omx clipper",
    "vendor": "openmixer",
    "version": "0.17.0",
    "doc": "Clips the peaks at a ceiling, with drive in front and an adjustable softness of the bend.",
    "features": [
      "audio-effect"
    ]
  },
  "controls": [
    {
      "id": 0,
      "symbol": "driveDb",
      "name": "Drive",
      "kind": "travel",
      "travel": {
        "min": 0,
        "max": 24,
        "step": 0,
        "unit": "dB",
        "default": 0,
        "scale": "linear"
      },
      "group": [
        "Clipper"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/clipper.json#CLIPPER_DRIVE_DB_RANGE",
          "at": "omx-dsp@0.28.0"
        }
      }
    },
    {
      "id": 1,
      "symbol": "ceilingDb",
      "name": "Ceiling",
      "kind": "travel",
      "travel": {
        "min": -24,
        "max": 0,
        "step": 0,
        "unit": "dB",
        "default": 0,
        "scale": "linear"
      },
      "group": [
        "Clipper"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/clipper.json#CLIPPER_CEILING_DB_RANGE",
          "at": "omx-dsp@0.28.0"
        }
      }
    },
    {
      "id": 2,
      "symbol": "softnessPct",
      "name": "Softness",
      "kind": "travel",
      "travel": {
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "default": 0,
        "scale": "stepped"
      },
      "group": [
        "Clipper"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/clipper.json#CLIPPER_SOFTNESS_PCT_RANGE",
          "at": "omx-dsp@0.28.0"
        }
      }
    }
  ],
  "ports": [
    {
      "id": 0,
      "name": "in",
      "kind": "audio",
      "direction": "in",
      "role": "main",
      "channels": 2,
      "layout": "stereo"
    },
    {
      "id": 0,
      "name": "out",
      "kind": "audio",
      "direction": "out",
      "role": "main",
      "channels": 2,
      "layout": "stereo"
    }
  ],
  "needs": {
    "extensions": {
      "optional": [
        "lv2:hardRTCapable"
      ]
    }
  },
  "latency": {
    "reports": true
  },
  "extensions": {
    "clap": {
      "clap_plugin_descriptor.features": [
        "CLAP_PLUGIN_FEATURE_DISTORTION",
        "CLAP_PLUGIN_FEATURE_STEREO"
      ]
    },
    "lv2": {
      "rdf:type": [
        "lv2:Plugin",
        "lv2:DistortionPlugin"
      ]
    }
  },
  "source": {
    "impl": "plugins/omx-clipper/omx_clipper_clap.c#clap_entry"
  }
}
