/*
 * omx_{{kernel}}_clap.c — the CLAP face of {{stem}}: lib/omx_clap_face.c, the face every plugin shares, over
 * this plugin's descriptor. Every number comes from generated/omx_{{kernel}}_params.h (tools/gen.mjs, from
 * {{stem}}.decl.json); the DSP is omx-dsp's {{kernel}} kernel, reached through omx_{{kernel}}_core.h's vtable.
 */
#include "omx_clap_face.h"

/* The generated table FIRST: its guard is omx-dsp's own, so the instance header reads this table. */
#include "omx_{{kernel}}_params.h"
#include "omx_{{kernel}}_core.h"
{{#metered}}#include <omx-clap-host/clap_meters.h>
#include "omx_meter_ring.h"
{{/metered}}
static const char *G_FEATURES[] = {OMX_{{K}}_CLAP_FEATURES, NULL};
{{#metered}}
/* The declaration's meters, in order: the index is the CLAP meter id; each one's channels sit at `at` among
 * the {{meterValues}} values the face publishes after a block. */
_Static_assert({{meterValues}}u <= OMX_METER_RING_MAX, "one publication holds every meter's values");
static const struct omx_face_meter G_METERS[] = {
{{#meters}}    {"{{meterName}}", {{meterKind}}, {{meterChannels}}u, {{meterOffset}}u, {{meterMin}}, {{meterMax}}, {{meterSource}}},
{{/meters}}};
{{/metered}}
static const struct omx_face G_FACE = {
    OMX_FACE_TABLES({{K}}), .features = G_FEATURES, .core = &OMX_{{K}}_CORE,
{{#keyed}}    .key_symbol = "{{keySymbol}}",
{{/keyed}}{{#metered}}    .meters = G_METERS, .meter_count = {{meterCount}}u, .meter_values = {{meterValues}}u,
{{/metered}}};

static const struct omx_clap_face G_CLAP = OMX_CLAP_FACE(&G_FACE, G_FEATURES, OMX_{{K}}_CLAP_ID, OMX_{{K}}_NAME, OMX_{{K}}_VENDOR,
                                                         OMX_{{K}}_URL, OMX_{{K}}_VERSION, OMX_{{K}}_DESCRIPTION);

static const void *e_factory(const char *id) { return omx_clap_face_factory(&G_CLAP, id); }

/* The entry by name, for a host that links the plugin statically and opens it by id without dlopen. */
const clap_plugin_entry_t omx_clap_entry_{{kernel}} = {CLAP_VERSION_INIT, omx_clap_face_init, omx_clap_face_deinit, e_factory};

#ifndef OMX_CLAP_STATIC
/* A standalone .clap for a foreign host: the same entry under CLAP's exported name. */
CLAP_EXPORT const clap_plugin_entry_t clap_entry = {CLAP_VERSION_INIT, omx_clap_face_init, omx_clap_face_deinit, e_factory};
#endif
