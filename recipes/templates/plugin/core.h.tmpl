/*
 * omx_{{kernel}}_core.h — {{stem}}'s binding to omx-dsp's {{kernel}} kernel: the ONE place both faces
 * (omx_{{kernel}}_clap.c, omx_{{kernel}}_lv2.c) reach the DSP. It holds no DSP of its own: it hands the
 * declared parameter values, by name, to omx-dsp's instance face (<omxdsp/fx/omx_{{kernel}}_instance.h>)
 * and runs it. The instance is plain inline state: nothing is allocated, locked or called into the
 * system, in process or at activate.
 *
 * GENERATED — DO NOT EDIT BY HAND. Produced by tools/gen.mjs from plugins/{{stem}}/{{stem}}.decl.json and
 * the face's resolve() prototype: each argument takes the parameter whose contract control it names.
{{#renames}} * RENAME OWED by omx-dsp's name conformance: resolve argument `{{arg}}` is the contract's `{{rename}}`.
{{/renames}} */
#ifndef OMX_{{K}}_CORE_H
#define OMX_{{K}}_CORE_H

#include <math.h>
#include <stdint.h>
#include <string.h>

/* The generated table FIRST: its guard is omx-dsp's own, so the instance header reads this table. */
#include "omx_{{kernel}}_params.h"

#include <omxdsp/fx/omx_{{kernel}}_instance.h>

/** The kernel's state and what a block runs with. */
typedef struct {
  uint32_t rate;
  {{faceType}} inst;
} Omx{{Kernel}}Core;

/** A fresh instance at `rate`: every state word zero. A rate the kernel does not declare leaves it a wire. */
static inline void omx_{{kernel}}_core_init(Omx{{Kernel}}Core *c, uint32_t rate) {
  memset(c, 0, sizeof *c);
  c->rate = rate;
  (void)omx_{{kernel}}_instance_init(&c->inst, ({{srType}})rate);
}

/** The block's parameters (declaration order) and the host's bypass, each to its resolve() argument. */
static inline void omx_{{kernel}}_core_resolve(Omx{{Kernel}}Core *c, const float *values, int bypass) {
  omx_{{kernel}}_instance_resolve(&c->inst, bypass{{#binding}},
                                  /* {{arg}} */ {{value}}{{/binding}});
}

/** The latency the kernel adds, in samples. */
static inline uint32_t omx_{{kernel}}_core_latency(const Omx{{Kernel}}Core *c) {
  (void)c;
  return (uint32_t)lrintf((float)({{latency}}));
}

/** One block, stereo; the outputs may alias the inputs. */
static inline void omx_{{kernel}}_core_run(Omx{{Kernel}}Core *c, const float *in_l, const float *in_r, float *out_l,
                                         float *out_r, uint32_t frames) {
  omx_{{kernel}}_instance_run(&c->inst, in_l, in_r, out_l, out_r, frames);
}

#endif /* OMX_{{K}}_CORE_H */
